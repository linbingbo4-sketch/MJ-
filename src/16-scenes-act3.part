<style>
/* ── VII · This Is It (rehearsal room) ── */
[data-era="tii"] { --ink: #f1efe9; --acc: #f2c230; --acc2: #ffffff; --dim: rgba(241, 239, 233, .56); --faint: rgba(241, 239, 233, .22); --line: rgba(241, 239, 233, .15); }
.tape { display: inline-block; padding: 10px 34px 6px; background: linear-gradient(180deg, #f6cc3e, #e9b923); color: #161310; font-family: 'Permanent Marker', var(--f-en); letter-spacing: .04em; rotate: -2deg; box-shadow: 0 6px 16px rgba(0,0,0,.4);
  clip-path: polygon(0 6%, 3% 0, 7% 8%, 12% 1%, 18% 6%, 25% 0, 33% 5%, 41% 1%, 50% 7%, 58% 0, 66% 6%, 74% 1%, 82% 7%, 90% 0, 96% 6%, 100% 2%, 99% 94%, 95% 100%, 89% 93%, 81% 99%, 72% 94%, 63% 100%, 54% 95%, 45% 100%, 36% 94%, 27% 99%, 18% 93%, 9% 100%, 3% 94%, 0 98%); }
[data-scene="tii"] .cc-en { font-size: 70px; }
.grid50 { display: grid; grid-template-columns: repeat(10, 66px); gap: 14px; }
.grid50 i { position: relative; width: 66px; height: 66px; border-radius: 4px; border: 2px solid rgba(242, 194, 48, .5); background: rgba(242, 194, 48, .06); font: 600 14px/1 var(--f-num); font-style: normal; color: rgba(242, 194, 48, .7); display: grid; place-items: end start; padding: 0 0 6px 7px;
  transition: background .5s ease, box-shadow .5s ease, border-color .5s ease, color .5s ease; transition-delay: calc(var(--k) * 12ms); }
.grid50.lit i { background: linear-gradient(160deg, #ffe7a3, #f2c230); border-color: #ffe7a3; color: #4a3608; box-shadow: 0 0 22px rgba(242, 194, 48, .55); }
.grid50.dark i { transition: all .12s linear; transition-delay: 0s; background: transparent; border-color: rgba(241, 239, 233, .14); color: transparent; box-shadow: none; }
.date625 { font: 600 210px/1 var(--f-num); color: #fff; white-space: nowrap; transition: left 1.2s var(--e-stage), top 1.2s var(--e-stage), font-size 1.2s var(--e-stage), opacity .8s ease, filter .8s ease; text-shadow: 0 0 40px rgba(255,255,255,.25); }
.redline { width: 1920px; height: 1080px; }
.redline svg { width: 100%; height: 100%; overflow: visible; }
.redline path { fill: none; stroke: #e0233a; stroke-width: 5; stroke-linecap: round; filter: drop-shadow(0 0 10px rgba(224, 35, 58, .8)); stroke-dasharray: 1; stroke-dashoffset: 1; }
.redline.on path { transition: stroke-dashoffset 1.8s var(--e-sine) .9s; stroke-dashoffset: 0; }
.ghost { width: 260px; height: 760px; }
.ghost svg { width: 100%; height: 100%; overflow: visible; }
.ghost .bulb { transition: opacity .3s ease; }
.floor-x { width: 70px; height: 70px; }
.floor-x::before, .floor-x::after { content: ''; position: absolute; left: 50%; top: 50%; width: 82px; height: 14px; margin: -7px 0 0 -41px; background: #e9b923; opacity: .8; }
.floor-x::before { rotate: 45deg; } .floor-x::after { rotate: -45deg; }

/* ── VIII · Legacy (house lights, amber) ── */
[data-era="legacy"] { --ink: #fff2dc; --acc: #ffb54a; --acc2: #ffd79a; --dim: rgba(255, 242, 220, .62); --faint: rgba(255, 242, 220, .26); --line: rgba(255, 242, 220, .18); }
.honor { display: flex; align-items: center; gap: 30px; font: 400 42px/1.35 var(--f-ko); white-space: nowrap; }
.honor .zh { font-family: var(--f-zh); }
.honor b { font: 600 22px/1 var(--f-num); letter-spacing: .3em; color: var(--acc); width: 170px; text-align: right; flex: none; }
.trip { display: flex; gap: 50px; }
.panel { width: 520px; height: 520px; border-radius: 8px; border: 1px solid var(--faint); background: linear-gradient(180deg, rgba(255,255,255,.04), rgba(0,0,0,.18)); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 22px; text-align: center;
  opacity: .22; filter: blur(1px); transition: opacity .9s var(--e-stage), filter .9s var(--e-stage), border-color .9s ease, box-shadow .9s ease, transform .9s var(--e-stage); transform: translateY(16px); }
.panel.on { opacity: 1; filter: none; border-color: rgba(255, 181, 74, .7); box-shadow: 0 0 60px rgba(255, 181, 74, .18), inset 0 0 40px rgba(255, 181, 74, .08); transform: none; }
.panel .pi { width: 210px; height: 150px; color: var(--acc2); }
.panel .pi svg { width: 100%; height: 100%; overflow: visible; }
.panel .from { font: 400 40px/1.2 var(--f-ko); color: var(--dim); }
.panel .from .zh { font-family: var(--f-zh); }
.panel .arr { font: 300 40px/1 var(--f-en); color: var(--acc); }
.panel .to { font: 600 92px/1.1 var(--f-ko-h); color: var(--ink); }
.panel .to .zh { font-family: var(--f-zh-h); }
.odo { display: flex; align-items: center; gap: 6px; font: 600 150px/1 var(--f-num); color: #fff6e6; }
.odo .w { width: 92px; height: 170px; overflow: hidden; border-radius: 8px; background: linear-gradient(180deg, #120b05, #2a1a0a 50%, #120b05); box-shadow: inset 0 10px 18px rgba(0,0,0,.8), inset 0 -10px 18px rgba(0,0,0,.8), 0 0 0 2px rgba(255, 181, 74, .25); position: relative; }
.odo .w .strip { position: absolute; left: 0; right: 0; top: 0; display: flex; flex-direction: column; align-items: center; }
.odo .w .strip span { height: 170px; line-height: 170px; display: block; }
.odo .sep { width: 26px; text-align: center; color: var(--acc); }
.odo .cur { margin-right: 14px; color: var(--acc); }
.qmark { font: italic 400 120px/1 var(--f-en); color: var(--acc2); opacity: 0; transition: opacity 3s ease; }
.qmark.on { opacity: .2; animation: qdrift 9s ease-in-out infinite alternate; }
@keyframes qdrift { to { transform: translate(14px, -18px) rotate(6deg); } }

/* legacy · redesign */
.gwrap { display: flex; flex-direction: column; align-items: center; gap: 14px; }
.gframe { position: relative; padding: 0; border: 12px solid transparent; border-image: linear-gradient(160deg, #f3d48a, #a8742a 40%, #f0c870 60%, #7a5018) 1; box-shadow: 0 20px 50px rgba(0, 0, 0, .45), inset 0 0 0 2px rgba(0, 0, 0, .4); background: #1a1009; }
.gframe .gf-in { position: absolute; inset: 0; overflow: hidden; background: radial-gradient(ellipse 70% 60% at 50% 38%, #4a3018, #1a1009 75%); }
.gframe .gf-in .fig { pointer-events: none; }
.gf-cap { font: 600 20px/1 var(--f-num); letter-spacing: .4em; color: var(--acc2); padding: 6px 12px; background: rgba(0, 0, 0, .25); border-radius: 3px; }
.panel { width: 440px; height: 470px; gap: 14px; }
.panel .p-mv { margin-top: 4px; }
.panel .pfig { position: relative; width: 240px; height: 214px; overflow: hidden; border-radius: 6px; background: radial-gradient(ellipse at 50% 40%, rgba(255, 200, 130, .14), transparent 70%); }
.panel .to { font-size: 80px; }
.marquee { padding: 34px 44px; border-radius: 14px; background: linear-gradient(180deg, #2a1a0a, #140c05); box-shadow: 0 0 0 3px rgba(255, 181, 74, .55), 0 30px 80px rgba(0, 0, 0, .5); }
.marquee::before { content: ''; position: absolute; inset: 10px; border-radius: 8px; pointer-events: none;
  background: radial-gradient(circle, #fff3d1 0 3.2px, rgba(255, 196, 102, .7) 4px, transparent 6px) 0 0 / 30px 30px; -webkit-mask: linear-gradient(#000, #000) content-box, linear-gradient(#000, #000); -webkit-mask-composite: xor; mask-composite: exclude; padding: 8px; animation: chase 1.2s steps(2) infinite; }
@keyframes chase { 50% { background-position: 15px 0; } }

/* ── Finale ── */
[data-scene="finale"] .t, [data-scene="finale"] .h-xl, [data-scene="finale"] .b-l { transition: color 1.6s ease; }
[data-scene="finale"].lit { --ink: #2b1c0e; --dim: rgba(43, 28, 14, .66); --acc: #8a4a12; }
.word { font: 500 58px/1.2 var(--f-ko-h); white-space: nowrap; opacity: 0; transition: opacity 1s ease, filter 1s ease, text-shadow 1s ease; filter: blur(1px); }
.word.shown { opacity: .2; }
.word .zh { font-family: var(--f-zh-h); }
.word.seen { opacity: .62; filter: none; }
.word.lit { opacity: 1; filter: none; text-shadow: 0 0 30px rgba(255, 220, 170, .35); }
.const { width: 1920px; height: 1080px; }
.const svg { width: 100%; height: 100%; }
.const line { stroke: rgba(255, 233, 196, .32); stroke-width: 1.5; stroke-dasharray: 4 6; opacity: 0; transition: opacity 1s ease; }
.const line.on { opacity: 1; }
.thanks { font: 600 170px/1.05 var(--f-ko-h); color: var(--ink); }
.thanks .zh { font-family: var(--f-zh-h); }
.credit { font: 500 22px/1 var(--f-num); letter-spacing: .42em; color: var(--dim); }
</style>

<script>
/* ═══ 10 · VII THIS IS IT ═══ */
const GHOST = `<svg viewBox="0 0 260 760" fill="none" stroke="#bdb8ae" stroke-width="4" stroke-linecap="round">
  <defs><radialGradient id="bulbG"><stop offset="0" stop-color="#fff"/><stop offset=".35" stop-color="#fff6dc"/><stop offset="1" stop-color="#ffd27a" stop-opacity="0"/></radialGradient></defs>
  <circle class="bulb" cx="130" cy="96" r="70" fill="url(#bulbG)" stroke="none"/>
  <path d="M110 70 C 110 50 150 50 150 70 C 150 92 140 100 140 116 L 120 116 C 120 100 110 92 110 70 Z" fill="#fffdf4" fill-opacity=".85" stroke-width="2"/>
  <path d="M98 44 C 96 20 164 20 162 44 L 166 120 L 94 120 Z" stroke-width="3"/><path d="M96 70 L 164 70 M95 96 L 165 96 M118 24 L 112 120 M142 24 L 148 120" stroke-width="2"/>
  <rect x="114" y="120" width="32" height="20" rx="3" fill="#3a3632"/>
  <line x1="130" y1="140" x2="130" y2="690"/>
  <path d="M130 690 L 40 750 M130 690 L 220 750 M130 690 L 130 752"/>
  <path d="M126 160 C 80 200 60 420 92 700" stroke="#57524b" stroke-width="2.5"/>
</svg>`;
Scenes.define('tii', {
  build(el, sc) {
    const back = layer(-.2), mid = layer(.08), stg = layer(.3);
    el.append(back, mid, stg);
    back.append(...[[260, 980], [620, 1010], [1180, 990], [1500, 1020]].map(([x, y]) => A('div.floor-x', x, y, { cls: 'rv', show: '0', style: 'rotate:8deg' })));
    this.op = opener(mid, sc, { act: 3, card: { num: 'VII', title: L('디스 이즈 잇', '《This Is It》'), en: '<span class="tape">THIS IS IT</span>', years: L('2009') } });
    $('.cc', this.op.card).classList.add('endup');
    this.ghost = A('div.ghost', 1690, 600, { cls: 'rv', html: GHOST });
    back.append(this.ghost);
    /* 0 · fifty nights, and a man sketched mid-move */
    this.grid = h('div.grid50', {}, ...Array.from({ length: 50 }, (_, k) => h('i', { style: { '--k': k }, text: String(k + 1).padStart(2, '0') })));
    this.gridW = A('div', 1080, 600, { cls: 'rv' }, this.grid);
    this.gl1 = A('div.lab.nowrap', 700, 352, { anchor: 'ay', cls: 'rv down' }, T(L('2009. 3 · 런던 O2 · 50회 공연', '2009年3月 · 伦敦 O2 · 50 场演出')));
    this.gl2 = A('div.b-m.nowrap', 700, 850, { anchor: 'ay', cls: 'rv up', d: .6 }, T(L('스스로 붙인 이름 — ‘마지막 커튼콜’', '他自己称之为——「最后的谢幕」')));
    mid.append(this.gridW, this.gl1, this.gl2);
    this.sk = stageFig(stg, { costume: 'tii', pose: 'reach', style: 'line', line: 'rgba(242, 194, 48, .9)', lineBg: '#1e1e21', x: 360, y: 960, h: 720, glow: 'rgba(242, 194, 48, .25)', rim: null, glowPx: 8, shadow: 'none' });
    /* 1 · the date */
    this.date = A('div.date625', 960, 520, { cls: 'rv blur' }, '2009. 6. 25');
    mid.append(this.date,
      A('div.lab.center.nowrap', 960, 690, { show: '1-1', d: 1.4 }, T(L('쉰 살', '五十岁'))),
      A('div.b-m.center.nowrap', 960, 790, { show: '1-1', d: 2.2, style: 'color:var(--dim)' }, T(L('50회의 공연, 단 한 번도 열리지 못했다', '50 场演出，一场也未能举行'))));
    /* 2 · ten years to the day */
    const mini = h('div.ticket', { style: { scale: '.62' } },
      h('div.tk-main', {}, h('div.tk-k', { text: 'MJ & FRIENDS' }), h('div.tk-e', { text: 'BENEFIT CONCERT · SEOUL' }), h('div.tk-v', {}, T(L('잠실 올림픽 주경기장', '蚕室奥林匹克主体育场'))), h('div.tk-d', { text: '1999. 6. 25' }), h('div.tk-seal', { html: "SEOUL<br>'99" })),
      h('div.tk-stub', {}, h('span', { text: 'ADMIT ONE' })));
    mini.classList.add('glow');
    this.mini = A('div', 470, 520, { cls: 'rv left slow' }, mini);
    this.red = A('div.redline', 960, 540, { cls: 'rv', html: `<svg viewBox="0 0 1920 1080"><path pathLength="1" d="M700 520 C 830 330 1060 330 1190 505"/></svg>` });
    mid.append(this.mini, this.red,
      this.tenYears = A('div.h-m.num.center.nowrap', 945, 300, { show: '2-2', d: 2.4, style: 'color:#ff5a5f;font-family:var(--f-num);font-size:84px;font-weight:600' }, T(L('10년 · 3,653일', '10 年 · 3653 天'))),
      this.tenLater = A('div.b-m.center.nowrap', 945, 700, { show: '2-2', d: 2.9 }, T(L('정확히, 10년 뒤', '整整十年之后'))));
    /* 3 · the last stage was a rehearsal: a sketch under the ghost light */
    this.sk2 = stageFig(stg, { costume: 'tii', pose: 'person', style: 'line', line: 'rgba(241, 239, 233, .85)', lineBg: '#202023', x: 1330, y: 980, h: 700, show: '3', d: 1.4, glow: 'rgba(255, 236, 190, .22)', rim: null, glowPx: 8, shadow: 'pool', p: { neck: 4, turn: .3, nSh: 30, nEl: 70, nHand: Figure.HI('open'), fSh: -14, fEl: 30 } });
    mid.append(stack(150, 480, { anchor: 'ay', align: 'left', gap: 24 },
        R('lab', '3', .9, T(L('2009. 10 · 영화 〈This Is It〉', '2009年10月 · 电影《This Is It》'))),
        R('h-m', '3', 1.2, T(L('우리가 볼 수 있는 마지막 무대는,', '我们能看到的最后的舞台，'))),
        R('h-l', '3', 1.8, T(L('리허설이었다', '是一场排练')), 'up', { color: 'var(--acc)' }),
        R('', '3', 2.6, mvSwitch('thisisit', { label: 'TRAILER' }))),
      A('div', 640, 830, { show: '3', d: 2.4, cls: 'drop', style: 'font-size:66px' }, h('span.tape', { text: 'THIS IS IT' })));
    clickable(this.sk2.hitbox(280), () => { if (this.i === 3) this.sk2.seq([['reach', 520, 500], ['snap', 380, 200], [{ neck: 4, turn: .3, nSh: 30, nEl: 70, nHand: Figure.HI('open'), fSh: -14, fEl: 30, nHip: 2, nKnee: 4, fHip: -2, fKnee: 3, lean: 0 }, 700]]); });
    mid.append(itip(1460, 230, L('클릭 · 리허설 한 동작', '点一下 · 排练一个动作'), '3'));
  },
  beat(i, ctx) {
    this.i = i;
    [this.sk, this.sk2].forEach(f => f.stop());
    const bulb = $('.bulb', this.ghost);
    const ghostLight = (k = 1) => ({ id: 'g', x: 1690, y: 330, rx: 1150, ry: 860, soft: .95, i: .9 * k, cone: false, halo: false });
    if (i === 0) {
      const t = this.op.run(ctx);
      [this.gridW, this.gl1, this.gl2, this.sk.box].forEach(e => vis(e, 'off')); this.grid.classList.remove('lit', 'dark');
      this.sk.pose('reach');
      ctx.after(t, () => { [this.gridW, this.gl1, this.gl2, this.sk.box].forEach(e => vis(e, 'on')); ctx.after(500, () => this.grid.classList.add('lit')); ctx.after(900, () => this.sk.seq([['snap', 600, 300], ['reach', 700]])); });
      vis(this.ghost, 'on'); bulb.style.opacity = 1;
      ctx.light({ lights: [ghostLight(.9), { id: 'w', x: 900, y: 600, rx: 900, ry: 460, soft: .5, i: .9 }] });
    } else this.op.hide();
    if (i >= 1) [this.gl1, this.gl2].forEach(e => vis(e, 'gone'));
    vis(this.sk.box, i === 0 ? (this.sk.box.classList.contains('on') ? 'on' : 'off') : 'gone');
    vis(this.gridW, i <= 1 ? (i === 1 ? 'on' : this.gridW.classList.contains('on') ? 'on' : 'off') : 'gone');
    if (i === 1) {
      this.grid.classList.remove('lit'); this.grid.classList.add('dark');
      vis(this.date, 'on'); Object.assign(this.date.style, { left: '960px', top: '520px', fontSize: '210px' });
      bulb.style.opacity = 0; vis(this.ghost, 'on');
      ctx.light({ ambient: .975, lights: [{ id: 'd', x: 960, y: 640, rx: 640, ry: 330, soft: .55, i: .85, cone: false }] }, { dur: ctx.fwd ? .25 : .4 });
    }
    if (i === 2) {
      vis(this.date, 'on'); Object.assign(this.date.style, { left: '1440px', top: '520px', fontSize: '130px' });
      vis(this.mini, 'on'); this.red.classList.toggle('on', true);
      if (ctx.fwd) { this.red.classList.remove('on'); void this.red.offsetWidth; this.red.classList.add('on'); }
      ctx.light({ ambient: .95, lights: [{ id: 'd', x: 1440, y: 520, rx: 380, ry: 170, soft: .35 }, { id: 't', x: 470, y: 520, rx: 360, ry: 220, soft: .35, delay: .2 }, { id: 'r', x: 945, y: 470, rx: 560, ry: 300, soft: .6, i: .75, cone: false },
        textLight('y', this.tenYears, { i: .7, delay: ctx.fwd ? 2.4 : 0 }), textLight('x', this.tenLater, { i: .8, delay: ctx.fwd ? 2.9 : 0 })] });
    } else { this.red.classList.remove('on'); vis(this.mini, i > 2 ? 'gone' : 'off'); }
    if (i >= 3) vis(this.date, 'gone'); else if (i < 1) vis(this.date, 'off');
    if (i === 3) {
      vis(this.ghost, 'on');
      this.sk2.pose('person', { neck: 4, turn: .3, nSh: 30, nEl: 70, nHand: Figure.HI('open'), fSh: -14, fEl: 30 });
      const room = [ghostLight(1), { id: 'w', x: 640, y: 560, rx: 760, ry: 420, soft: .6, i: .8, cone: false }, { id: 'm', x: 1330, y: 620, rx: 300, ry: 430, soft: .4, i: .7 }];
      if (ctx.fwd) {
        bulb.style.opacity = 0;
        ctx.light({ ambient: .97, lights: [ghostLight(1)] }, { dur: .01 });
        Light.flicker('g', [[0, 0], [.15, .8], [.22, .1], [.4, 1], [.48, .3], [.62, 1], [1, 1]]);
        ctx.after(150, () => { bulb.style.opacity = 1; });
        ctx.after(1100, () => ctx.light({ ambient: .84, lights: room }, { dur: 1.2 }));
      } else { bulb.style.opacity = 1; ctx.light({ ambient: .84, lights: room }); }
    }
  },
  leave() { [this.sk, this.sk2].forEach(f => f.stop()); },
});

/* ═══ 11 · VIII LEGACY ═══ */
const PICON = {
  film: `<svg viewBox="0 0 150 110" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linejoin="round"><rect x="8" y="26" width="58" height="44" rx="5"/><path d="M22 70 L 18 90 M52 70 L 56 90"/><path d="M80 48 L 96 48" stroke-dasharray="3 5"/><circle cx="124" cy="30" r="16"/><circle cx="124" cy="76" r="16"/><path d="M104 54 L 146 54 L 146 100 L 104 100 Z"/></svg>`,
  dance: `<svg viewBox="0 0 150 110" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 90 C 18 72 30 66 34 52"/><path d="M40 96 C 46 80 52 74 50 58"/><circle cx="42" cy="34" r="9"/><path d="M80 48 L 96 48" stroke-dasharray="3 5"/><path d="M106 20 L 146 20 L 146 66 L 126 66 L 112 84 L 114 66 L 106 66 Z"/><path d="M116 36 L 136 36 M116 48 L 130 48"/></svg>`,
  event: `<svg viewBox="0 0 150 110" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 92 L 70 92 M14 92 L 14 70 L 62 70 L 62 92"/><path d="M38 70 L 30 30 M38 70 L 46 30" stroke-dasharray="4 5"/><path d="M80 48 L 96 48" stroke-dasharray="3 5"/><circle cx="126" cy="54" r="8" fill="currentColor"/><path d="M112 40 C 104 48 104 60 112 68 M140 40 C 148 48 148 60 140 68 M102 30 C 88 46 88 62 102 78 M150 30 C 164 46 164 62 150 78"/></svg>`,
};
function odometer() {
  const el = h('div.odo', {}, h('span.cur', { text: '$' }));
  const target = '1000000000';
  const wheels = [];
  [...target].forEach((d, k) => {
    if (k > 0 && (target.length - k) % 3 === 0) el.append(h('span.sep', { text: ',' }));
    const strip = h('div.strip', {}, ...Array.from({ length: 30 }, (_, n) => h('span', { text: String(n % 10) })));
    const w = h('div.w', {}, strip); el.append(w);
    wheels.push({ strip, d: +d, k });
  });
  el.roll = (on, instant) => {
    wheels.forEach(({ strip, d, k }) => {
      const idx = on ? (d === 0 ? 20 : 10 + d) : 0;
      strip.style.transition = instant || !on ? 'none' : `transform ${2.2 + (wheels.length - k) * .16}s cubic-bezier(.12, .8, .2, 1) ${.2 + k * .05}s`;
      strip.style.transform = `translateY(${-idx * 170}px)`;
    });
  };
  return el;
}
Scenes.define('legacy', {
  build(el, sc) {
    const back = layer(-.2), mid = layer(.08), stg = layer(.26);
    el.append(back, mid, stg);
    this.op = opener(mid, sc, { card: { num: 'VIII', title: L('유산', '遗产'), years: L('오늘', '今天') }, hold: 2800 });
    /* 0 · a salon hang: one frame per era */
    const G = [
      { x: 246, y: 426, w: 250, h: 330, cos: 'child', pose: 'j5', yr: '1969', move: [['sing', 360, 300], ['j5', 400]] },
      { x: 542, y: 396, w: 270, h: 390, cos: 'tux', pose: 'groove', yr: '1979', move: [['point', 300, 120], ['groove', 380]] },
      { x: 846, y: 456, w: 250, h: 320, cos: 'thriller', pose: 'zombie', yr: '1982', move: [[{ nSh: 30, nEl: 84, fSh: 22, fEl: 88, neck: 18 }, 260, 80], ['zombie', 320]] },
      { x: 1182, y: 430, w: 350, h: 390, cos: 'smooth', pose: 'lean', yr: '1988', move: [[{ tilt: 0 }, 500, 200], [{ tilt: 45 }, 900]] },
      { x: 1515, y: 436, w: 240, h: 330, cos: 'military', pose: 'statue', yr: '1993', move: [[{ head: 16 }, 900, 300], [{ head: 0 }, 900]] },
      { x: 1760, y: 420, w: 210, h: 300, cos: 'tii', pose: 'reach', yr: '2009', move: [['snap', 320, 120], ['reach', 420]] },
    ];
    this.gallery = G.map((g, k) => {
      const fr = h('div.gframe', { style: { width: g.w + 'px', height: g.h + 'px' } }, h('div.gf-in'));
      const lean = g.pose === 'lean';
      const f = new Figure.Fig({ costume: g.cos, pose: g.pose, style: 'costume', fx: false, shadow: 'pool' });
      f.place(lean ? g.w * .2 : g.w / 2, g.h - 22, (lean ? .56 : .8) * g.h * (lean ? 1.4 : 1));
      $('.gf-in', fr).append(f.el);
      tiltify(fr, 9);
      fr.addEventListener('pointerenter', () => { if (Pointer.live && this.i === 0) f.seq(g.move); });
      const w = A('div.gwrap', g.x, g.y, { cls: 'rv up', d: .1 + k * .12 }, fr, h('div.gf-cap', { text: g.yr }));
      mid.append(w); w.fig = f; return w;
    });
    this.honors = [
      h('div.honor.rv.up', {}, h('b', { text: 'GUINNESS' }), T(L('‘역사상 가장 성공한 엔터테이너’', '「史上最成功的艺人」'))),
      h('div.honor.rv.up', { style: { '--d': '.3s' } }, h('b', { text: 'HALL OF FAME' }), T(L('로큰롤 명예의 전당 · 두 번', '摇滚名人堂 · 两度入选'))),
    ];
    mid.append(stack(960, 872, { gap: 26, align: 'left' }, ...this.honors));
    mid.append(itip(960, 712, L('액자를 가리켜 보세요', '把指针移到画框上'), '0-0'));
    /* 1 · music you watch: three panels, then a formation */
    const P = (fo, from, to) => {
      const pnl = h('div.panel', {}, h('div.pfig'), h('div.from', {}, T(from)), h('div.arr', { text: '↓' }), h('div.to', {}, T(to)));
      const f = new Figure.Fig(Object.assign({ fx: false, shadow: 'pool', style: 'costume' }, fo));
      f.place(fo.px ?? 120, 206, fo.ph ?? 190); $('.pfig', pnl).append(f.el); pnl.fig = f;
      if (fo.work) pnl.append(h('div.p-mv', {}, mvSwitch(fo.work, { sm: true, label: fo.workLabel })));
      return pnl;
    };
    this.panels = [
      P({ costume: 'thriller', pose: 'zombie', work: 'thriller' }, L('뮤직비디오', 'MV'), L('영화', '电影')),
      P({ costume: 'billie', pose: 'toe', work: 'motown25', workLabel: 'LIVE' }, L('춤', '舞蹈'), L('언어', '语言')),
      P({ costume: 'military', pose: 'statue', work: 'superbowl', workLabel: 'LIVE' }, L('공연', '演出'), L('사건', '事件')),
    ];
    mid.append(A('div.h-m.center.nowrap', 960, 130, { show: '1-1', cls: 'down' }, T(L('음악을 ‘보는 것’으로', '把音乐变成「看」的艺术'))),
      A('div.trip', 960, 470, { show: '1-1', d: .2 }, ...this.panels));
    this.kpop = A('div.b-m.center.nowrap', 960, 770, { cls: 'rv up' }, T(L('그리고 오늘, K-pop 무대 위의 그 문법', '以及今天，K-pop 舞台上的那套语法')));
    mid.append(this.kpop);
    const JK = ['#3b3f6a', '#6a3b4a', '#2f5d5a', '#5a4a2f', '#4a2f5a', '#2f4a6a', '#6a5a3b'];
    this.crew = Array.from({ length: 7 }, (_, k) => {
      const d = Math.abs(k - 3), x = 960 + (k - 3) * 132, y = 1060 - d * 26;
      return stageFig(stg, { costume: 'person', pose: 'point', style: 'costume', fx: false, x, y, h: 220 - d * 14, c: { jacket: JK[k], hair: k % 2 ? 'short' : 'long' }, face: k < 3 ? 1 : (k > 3 ? -1 : 1) });
    });
    /* 2 · the marquee */
    this.odo = odometer();
    mid.append(A('div.lab.center.nowrap', 960, 280, { show: '2', cls: 'down' }, T(L('2026 · 영화 〈마이클〉 · 전 세계 흥행', '2026 · 电影《迈克尔》· 全球票房'))),
      A('div.marquee', 960, 480, { show: '2', cls: 'zoom' }, this.odo),
      A('div.h-s.center.nowrap', 960, 760, { show: '2', d: 3.6 }, T(L('그리고 동시에 — 다시 시작된 질문', '与此同时——追问再次开始'))));
    const r = rng(2026);
    this.qs = Array.from({ length: 14 }, (_, k) => {
      let x, y; do { x = 120 + r() * 1680; y = 120 + r() * 840; } while (Math.abs(x - 960) < 640 && Math.abs(y - 520) < 330);
      const q = A('div.qmark', x, y, { style: `font-size:${70 + r() * 90}px;animation-delay:${-r() * 9}s` }, '?'); back.append(q); return q;
    });
  },
  beat(i, ctx) {
    this.i = i;
    [...this.gallery.map(g => g.fig), ...this.panels.map(p => p.fig), ...this.crew].forEach(f => f.stop());
    this.gallery.forEach((g, k) => g.fig.pose(['j5', 'groove', 'zombie', 'lean', 'statue', 'reach'][k]));
    this.panels.forEach((p, k) => p.fig.pose(['zombie', 'toe', 'statue'][k]));
    this.crew.forEach(f => f.pose('point'));
    const house = (k) => ({ ambient: .3, wash: k });
    if (i === 0) {
      const t = this.op.run(ctx);
      [...this.honors, ...this.gallery].forEach(e => vis(e, 'off'));
      ctx.after(t, () => [...this.gallery, ...this.honors].forEach(e => vis(e, 'on')));
      const L0 = { lights: [{ id: 'h', x: 960, y: 560, rx: 1100, ry: 640, soft: .7, i: .6, cone: false, halo: false }] };
      if (ctx.fwd && ctx.first) { ctx.light({ ambient: .97, wash: 0, lights: [] }, { dur: .01 }); ctx.after(80, () => ctx.light({ ...house(.55), ...L0 }, { dur: 3 })); }
      else ctx.light({ ...house(.55), ...L0 });
    } else { this.op.hide(); [...this.honors, ...this.gallery].forEach(e => vis(e, 'gone')); }
    if (i === 1) {
      ctx.light({ ...house(.45), lights: [{ id: 'h', x: 960, y: 540, rx: 1100, ry: 560, soft: .6, i: .7, cone: false, halo: false }] });
      const at = [ctx.say('뮤직비디오는'), ctx.say('춤은'), ctx.say('공연은')], kp = ctx.say('오늘 우리가');
      this.panels.forEach(p => p.classList.remove('on'));
      vis(this.kpop, 'off'); this.crew.forEach(f => vis(f.box, 'off'));
      const crewIn = (instant) => {
        vis(this.kpop, 'on'); this.crew.forEach((f, k) => { if (instant) vis(f.box, 'on'); else ctx.after(Math.abs(k - 3) * 90, () => vis(f.box, 'on')); });
        if (!instant) ctx.after(900, () => this.crew.forEach(f => f.seq([['snap', 300, 60], ['kick', 280, 80], ['snap', 260, 60], ['point', 360]])));
      };
      if (!ctx.fwd) { this.panels.forEach(p => p.classList.add('on')); crewIn(true); }
      else { this.panels.forEach((p, k) => ctx.after(Math.max(600 + k * 900, at[k]), () => p.classList.add('on'))); ctx.after(Math.max(3400, kp), () => crewIn(false)); }
    } else { this.panels.forEach(p => p.classList.remove('on')); vis(this.kpop, 'off'); this.crew.forEach(f => vis(f.box, 'off')); }
    if (i === 2) {
      this.odo.roll(false, true);
      if (ctx.fwd) ctx.after(250, () => this.odo.roll(true)); else this.odo.roll(true, true);
      ctx.light({ ambient: .78, wash: .15, lights: [{ id: 'h', x: 960, y: 480, rx: 820, ry: 330, soft: .4, i: 1 }, { id: 'c', x: 960, y: 760, rx: 600, ry: 80, soft: .8, i: .8, cone: false, halo: false }] });
      this.qs.forEach((q, k) => { q.classList.remove('on'); ctx.after(3800 + k * 260, () => q.classList.add('on')); });
    } else { this.odo.roll(false, true); this.qs.forEach(q => q.classList.remove('on')); }
  },
  leave() { [...this.gallery.map(g => g.fig), ...this.panels.map(p => p.fig), ...this.crew].forEach(f => f.stop()); },
});

/* ═══ 12 · FINALE — the icon becomes a person; then the light turns to us ═══ */
Scenes.define('finale', {
  build(el) {
    const back = layer(-.15), mid = layer(.08), stg = layer(.26);
    el.append(back, mid, stg);
    const FX = this.FX = 1400;
    this.fig = stageFig(stg, { costume: 'billie', pose: 'point', x: FX, y: 950, h: 690, show: '0-3', glowPx: 10 });
    mid.append(A('div.b-l.nowrap', 160, 430, { anchor: 'ay', show: '0-0', cls: 'down', style: 'color:var(--dim)' }, T(L('스포트라이트 안의 그는,', '聚光灯下的他，'))),
      A('div.b-l.nowrap', 160, 430, { anchor: 'ay', show: '1-1', cls: 'down', d: .4, style: 'color:var(--dim)' }, T(L('스포트라이트 밖의 그는,', '聚光灯之外的他，'))));
    this.king = A('div.h-xl.nowrap', 154, 560, { anchor: 'ay', show: '0-1', cls: 'blur slow', d: .5 }, T(L('팝의 황제', '流行之王')));
    this.person = A('div.h-xl.nowrap', 154, 560, { anchor: 'ay', cls: 'rv blur slow' }, T(L('한 사람', '一个人')));
    mid.append(this.king, this.person);
    const W6 = [
      [L('어린 시절을 잃은 아이', '失去童年的孩子'), 900, 190, '어린 시절을'],
      [L('천재', '天才'), 1780, 230, '천재였고'],
      [L('거대한 산업', '庞大的产业'), 1760, 610, '거대한 산업'],
      [L('피고인', '被告'), 1560, 830, '피고인이었고'],
      [L('세 아이의 아버지', '三个孩子的父亲'), 880, 858, '세 아이의'],
    ];
    this.words = W6.map(([t, x, y, cue]) => { const w = A('div.word', x, y, {}, T(t)); w.cue = cue; w.pos = [x, y]; mid.append(w); return w; });
    const pts = [...W6.map(w => [w[1], w[2]]), [560, 560]];
    this.lines = h('div.const', { html: `<svg viewBox="0 0 1920 1080">${pts.slice(1).map((p, k) => `<line x1="${pts[k][0]}" y1="${pts[k][1]}" x2="${p[0]}" y2="${p[1]}"/>`).join('')}</svg>` });
    back.append(A('div', 960, 540, {}, this.lines));
    mid.append(stack(820, 520, { gap: 30 },
        R('b-l center nowrap', '2-2', 0, T(L('그 스포트라이트를 들고 있던 건,', '举着那盏聚光灯的，是')), 'down'),
        R('thanks center nowrap', '2-2', 2.2, T(L('우리', '我们')), 'zoom slow', { fontSize: '230px' })));
    this.creditName = R('b-s center nowrap', '3', 2.8, null, 'up', { color: 'var(--dim)' });
    mid.append(stack(780, 540, { gap: 16 },
      R('b-l center nowrap', '3', 0, T(L('무엇을 비추고, 무엇을 보지 않을지는', '照亮什么、忽略什么，')), 'down'),
      R('b-l center nowrap', '3', .5, T(L('지금도, 우리가 정합니다', '今天依然由我们决定'))),
      R('thanks center nowrap', '3', 1.3, T(L('감사합니다', '谢谢大家')), 'zoom slow', { margin: '34px 0 60px' }),
      R('credit center nowrap', '3', 2.4, 'BEYOND THE SPOTLIGHT'),
      R('center', '3', 3.2, mvSwitch('mitm')),
      this.creditName));
    const fill = () => { this.creditName.innerHTML = ''; this.creditName.append(T(Settings.get().name)); };
    fill(); if (this._offFill) this._offFill(); this._offFill = Settings.on(fill);
    mid.append(itip(560, 760, L('빛은 이제, 당신의 손에', '这束光，现在在你手里'), '1-3'));
  },
  beat(i, ctx, el) {
    const hard = .024, f = this.fig, FX = this.FX;
    f.stop();
    Torch.setFull(i >= 1);
    el.classList.toggle('lit', i >= 2);
    HUD.visible(i < 2);
    Era.plate(i >= 2 ? 'radial-gradient(ellipse 80% 75% at 50% 50%, #fff8ec 0%, #f6e7cf 55%, #e6c99c 100%)' : null, ctx.instant ? 0 : (i >= 2 ? 2.4 : .6));
    f.setLight({ glow: i >= 2 ? 'rgba(120, 70, 20, .22)' : 'rgba(255, 196, 130, .45)', rim: i >= 2 ? null : '#ffdcae' });
    const lines = $$('line', this.lines);
    this.words.forEach(w => { w.classList.remove('lit', 'seen'); w.classList.toggle('shown', i === 1); });
    lines.forEach(l => l.classList.remove('on'));
    vis(this.person, i === 1 ? 'off' : (i > 1 ? 'gone' : 'off'));
    this.king.style.opacity = '';
    if (i === 0) { f.pose('point'); ctx.light({ lights: [{ id: 's', x: FX, y: 560, rx: 330, ry: 470, soft: hard }, { id: 't', x: 460, y: 500, rx: 460, ry: 220, soft: 1, i: .9, cone: false, halo: false }] }, { dur: ctx.first ? 1.6 : .9 }); }
    if (i === 1) {
      const spot = (x, y, rx = 330, ry = 150) => ctx.light({ ambient: .955, lights: [{ id: 's', x, y, rx, ry, soft: .06 }, { id: 'm', x: FX, y: 560, rx: 300, ry: 440, soft: .5, i: .32, cone: false, halo: false }] }, { dur: .9 });
      const visit = (k) => {
        this.words.forEach((w, n) => { w.classList.toggle('lit', n === k); w.classList.toggle('seen', n < k); });
        if (k > 0) lines[k - 1].classList.add('on');
        const [x, y] = this.words[k].pos; spot(x, y, Math.max(240, this.words[k].offsetWidth * .62 + 60), 140);
        if (k === 3) f.to({ neck: 18, head: 6 }, 900);
      };
      const end = (instant) => {
        this.words.forEach(w => { w.classList.remove('lit'); w.classList.add('seen'); });
        lines.forEach(l => l.classList.add('on'));
        this.king.style.opacity = '0'; vis(this.person, 'on');
        if (instant) f.pose('person'); else f.to('person', 1600, ease.inOutSine);
        ctx.light({ ambient: .9, lights: [{ id: 's', x: FX, y: 560, rx: 320, ry: 470, soft: hard }, { id: 'c', x: 960, y: 550, rx: 1150, ry: 560, soft: 1, i: .38, cone: false, halo: false }, { id: 't', x: 460, y: 560, rx: 420, ry: 170, soft: 1, i: .9, cone: false, halo: false }] }, { dur: 1.1 });
      };
      if (!ctx.fwd) { end(true); return; }
      f.pose('point');
      ctx.after(300, () => f.to('stand', 1200));
      ctx.light({ ambient: .955, lights: [{ id: 's', x: FX, y: 560, rx: 330, ry: 470, soft: hard, i: .5 }] });
      this.words.forEach((w, k) => ctx.after(Math.max(400 + k * 700, ctx.say(w.cue)), () => visit(k)));
      ctx.after(Math.max(400 + 5 * 700 + 800, ctx.say('그리고 한 사람')), () => end(false));
    }
    if (i === 2) {
      f.pose('person');
      if (ctx.fwd) {
        ctx.light({ lights: [{ id: 's', x: FX, y: 560, rx: 320, ry: 470, soft: hard }] }, { dur: .6 });
        ctx.after(1100, () => ctx.light({ ambient: 0, bloom: .14, haze: .2, lights: [{ id: 's', x: 960, y: 540, rx: 2300, ry: 1500, soft: .5 }] }, { dur: 2.2, ease: ease.inOut }));
      } else ctx.light({ ambient: 0, bloom: .14, haze: .2, lights: [{ id: 's', x: 960, y: 540, rx: 2300, ry: 1500, soft: .5 }] });
    }
    if (i === 3) {
      ctx.light({ ambient: 0, bloom: .1, haze: .15, lights: [{ id: 's', x: 960, y: 540, rx: 2300, ry: 1500, soft: .5 }] });
      if (ctx.fwd) { f.pose('person'); ctx.after(2600, () => f.to('bow', 1400, ease.inOutSine)); } else f.pose('bow');
    }
  },
  leave() { HUD.visible(true); Era.plate(null, .4); Torch.setFull(false); this.fig.stop(); },
});
</script>
