<style>
/* ── subtitles of what is being said: Korean above, Chinese below, one sentence at a time ── */
#capt { position: absolute; left: 50%; bottom: 10px; translate: -50% 0; width: max-content; max-width: 1700px; padding: 8px 30px 10px; text-align: center; pointer-events: none;
  background: radial-gradient(ellipse at 50% 60%, rgba(0, 0, 0, .62), rgba(0, 0, 0, .38) 62%, transparent 78%); opacity: 0; visibility: hidden; transition: opacity .35s ease, visibility 0s linear .35s; }
#capt.on { opacity: 1; visibility: visible; transition: opacity .35s ease, visibility 0s; }
#capt .ck { font: 500 31px/1.3 var(--f-ko); color: #fbf6ec; letter-spacing: -.005em; text-shadow: 0 2px 3px rgba(0, 0, 0, .9), 0 0 18px rgba(0, 0, 0, .7); text-wrap: balance; }
#capt .cz { margin-top: 4px; font: 400 23px/1.34 var(--f-zh); color: rgba(251, 246, 236, .84); text-shadow: 0 2px 3px rgba(0, 0, 0, .9), 0 0 16px rgba(0, 0, 0, .7); text-wrap: balance; }
#capt .ck, #capt .cz { transition: opacity .22s ease; }
#capt.swap .ck, #capt.swap .cz { opacity: 0; }
#stage.film #capt, #stage.mv-open #capt { opacity: 0 !important; }
</style>

<script>
/* ═══ CAPTIONS — the script of each beat as stacked Korean / Chinese subtitles ═══
   A beat's speech is cut into sentences; Korean and Chinese are paired sentence by sentence (merged where one
   language uses fewer sentences), and each pair stays up for as long as its Korean takes at the rehearsed pace. */
const Captions = (() => {
  const el = h('div#capt', { 'aria-hidden': 'true' }, h('div.ck', { lang: 'ko' }), h('div.cz', { lang: 'zh-Hans' }));
  $('#subs').append(el);
  const ck = el.firstChild, cz = el.lastChild;
  let timers = [], shown = -1, cur = [], at = 0;
  const sentences = (s, re) => String(s || '').replace(/<[^>]+>/g, '').split(re).map(x => x.trim()).filter(Boolean);
  /* merge neighbours of the longer list until both have n pieces, keeping pieces of similar length */
  function squeeze(list, n, join = ' ') {
    const out = list.slice();
    while (out.length > n) {
      let best = 0, bl = Infinity;
      for (let i = 0; i < out.length - 1; i++) { const l = out[i].length + out[i + 1].length; if (l < bl) { bl = l; best = i; } }
      out.splice(best, 2, out[best] + join + out[best + 1]);
    }
    return out;
  }
  function pairs(b) {
    const ko = sentences(b.ko, /(?<=[.?!])\s+/), zh = sentences(b.zh, /(?<=[。？！])/);
    if (!ko.length || !zh.length) return [];
    const n = Math.min(ko.length, zh.length);
    const K = squeeze(ko, n), Z = squeeze(zh, n, '');
    return K.map((k, i) => ({ ko: k, zh: Z[i] }));
  }
  function clear() { timers.forEach(clearTimeout); timers = []; }
  function hide() { clear(); el.classList.remove('on'); shown = -1; }
  function put(p) {
    if (!el.classList.contains('on')) { ck.textContent = p.ko; cz.textContent = p.zh; el.classList.add('on'); return; }
    el.classList.add('swap');
    timers.push(setTimeout(() => { ck.textContent = p.ko; cz.textContent = p.zh; el.classList.remove('swap'); }, 220));
  }
  function show(beat, { lead = 0 } = {}) {
    clear();
    const b = BEATS[beat];
    if (VIEW !== 'stage' || !Settings.get().subs || !b || b.silent) { hide(); return; }
    const P = pairs(b); if (!P.length) { hide(); return; }
    shown = beat; cur = P; at = 0;
    /* by hand (the default): the first sentence now, the clicker moves on sentence by sentence */
    if (!Auto.on) { timers.push(setTimeout(() => { if (shown === beat) put(P[0]); }, lead * 1000)); return; }
    const rate = Scenes.rate();
    let t = lead;
    P.forEach((p, i) => {
      timers.push(setTimeout(() => { if (shown === beat) { at = i; put(p); } }, t * 1000));
      t += Math.max(1.6, syllables(p.ko) / rate + .35);
    });
  }
  /* the clicker: the next / previous sentence of this beat; false when there is none (the page turns instead) */
  function step(d) {
    if (Auto.on || shown < 0 || shown !== Director.beat || !Settings.get().subs || !cur.length) return false;
    const n = at + d;
    if (n < 0 || n >= cur.length) return false;
    clear(); at = n; put(cur[n]); return true;
  }
  const state = () => ({ beat: shown, at, of: cur.length });
  function init() {
    Director.onTurn((beat, mode) => { if (beat < 0) hide(); else show(beat, { lead: mode === 'next' ? .5 : 0 }); });
    Director.onTurn((beat) => MV.offer(beat));
    Settings.on((s) => { if (!s.subs) hide(); else if (shown < 0 && Director.beat >= 0) show(Director.beat); });
  }
  return { init, show, hide, pairs, step, state };
})();
</script>
