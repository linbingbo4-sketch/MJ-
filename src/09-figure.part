        if (t >= total) { off(); this._cyc = null; const keep = Object.assign({}, this.p); this.ik = null; this.p = keep; done && done(); }
      });
      this._cyc = off;
      return this;
    }
    /* a full turn on the spot */
    spinTurn(ms = 700, turns = 1, done) {
