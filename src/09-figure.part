      setTimeout(() => g.remove(), ms + 100);
      return g;
    }
    clearGhosts() { this.el.querySelectorAll('.fig-ghost').forEach(g => g.remove()); }
    /* the point (stage px) of a joint, e.g. 'nA.W' or 'headC' */
    stagePt(path) { const v = path.split('.').reduce((o, k) => o && o[k], this.J); return v ? this.toStage(v[0], v[1]) : null; }
    /* named places on the body, in stage px: hat, head, hand, sock, feet, chest, hip */
    anchor(name) {
      const J = this.J, B = this.B; if (!J) return [0, 0];
      let v;
