      else if (name === 'head') v = J.headC;
      else if (name === 'hand') v = mv(J.nA.W, J.nA.a3, B.hand * .42);
      else if (name === 'fhand') v = mv(J.fA.W, J.fA.a3, B.hand * .42);
      else if (name === 'sock') v = mix(J.nL.K, J.nL.A, .93);
      else if (name === 'fsock') v = mix(J.fL.K, J.fL.A, .93);
      else if (name === 'feet') v = [(J.nL.A[0] + J.fL.A[0]) / 2, 0];
      else if (name === 'chest') v = mix(J.waist, J.neckB, .6);
      else if (name === 'hip') v = J.pelvis;
      else v = J.pelvis;
      return this.toStage(v[0], v[1]);
    }
    setShadow(mode, k, sc) {
      this.shadow = mode; if (k != null) this.castK = k; if (sc != null) this.castS = sc;
      this.q['fg-cast'].style.display = mode === 'cast' ? '' : 'none'; this.q['fg-pool'].style.display = mode === 'none' ? 'none' : '';
      this.render(); return this;
    }
    /* face the other way, keeping the figure where it stands on stage */
    setFace(f) {
      if (f === this.face) return this;
      this.face = f; this.p.x = -(this.p.x || 0);
      this.setLight(); this.render();
      return this;
    }
    /* an invisible hit area (figure units, around the pelvis) for clicking or dragging the figure */
    hitbox(w = 240, top = -760) {
      const r = h('rect.fg-hit', { x: -w / 2, y: top, width: w, height: -top + 10, fill: 'transparent' });
      this.el.querySelector('.fg-root').append(r);
      this._hit = r; this._hitW = w; this.render();
      return r;
    }
  }
  function splitCol(col) {
    if (!col) return ['#000', 0];
    const m = String(col).match(/rgba?\(([^)]+)\)/);
    if (m) { const v = m[1].split(',').map(s => s.trim()); return [`rgb(${v[0]}, ${v[1]}, ${v[2]})`, v[3] != null ? +v[3] : 1]; }
    return [col, 1];
  }
  return { Fig, POSES, BASE, COSTUMES, HI };
})();
</script>
