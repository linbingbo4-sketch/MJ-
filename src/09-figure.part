        const tr = frame(J.nA.W, J.nA.a3), k = B.hand / 62;
        set('p-mic', limb(tr([18 * k, -10 * k]), tr([18 * k, -46 * k]), 4.6 * k, 5.6 * k) + circle(tr([18 * k, -54 * k]), 10 * k));
      } else set('p-mic', '');
      q['p-mic'].style.opacity = clamp(p.mic, 0, 1);
      if (p.umbrella > .01) {
        const tr = frame(J.nA.W, J.nA.a3), k = B.hand / 62, grip = tr([20 * k, 0]);
        const tip = [grip[0] + 4, grip[1] - 262], rim = 196, depth = 96, ribs = 8;
        const d = limb(grip, tip, 3.2, 3.2) + limb(grip, [grip[0], grip[1] + 30], 3.6, 3.6) + circle([grip[0] - 8, grip[1] + 30], 8) ;
        const bl = [tip[0] - rim, tip[1] + depth], br = [tip[0] + rim, tip[1] + depth];
        let canopy = 'M' + pt(br) + 'C' + pt([tip[0] + rim * 1.02, tip[1] + 18]) + ' ' + pt([tip[0] + rim * .55, tip[1] - 2]) + ' ' + pt([tip[0], tip[1]]) + 'C' + pt([tip[0] - rim * .55, tip[1] - 2]) + ' ' + pt([tip[0] - rim * 1.02, tip[1] + 18]) + ' ' + pt(bl);
        for (let i = 1; i <= ribs; i++) { const x0 = tip[0] - rim + ((i - 1) / ribs) * 2 * rim, x1 = tip[0] - rim + (i / ribs) * 2 * rim; canopy += 'Q' + pt([(x0 + x1) / 2, tip[1] + depth - 20]) + ' ' + pt([x1, tip[1] + depth + (i === ribs ? 0 : 2)]); }
        canopy += 'Z' + limb([tip[0], tip[1] + 2], [tip[0], tip[1] - 22], 3, 1.5);
        set('p-umb', d + canopy);
      } else set('p-umb', '');
