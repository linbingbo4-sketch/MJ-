        nDet = '';
      }
      if (c.gold) {
        const [bf, bb] = row([62, 27, 29, 42]), [bf2, bb2] = row([46, 27.5, 30.5, 44]);
        det2 = 'M' + pt(bf) + 'L' + pt(bb) + 'L' + pt(bb2) + 'L' + pt(bf2) + 'Z';
        nDet = limb(mv(J.nA.S, J.fwdUp, -16), mv(J.nA.S, J.fwdUp, 16), 5, 5) + limb(mix(J.nA.E, J.nA.W, .86), mix(J.nA.E, J.nA.W, .97), r[2] + 2.6, r[2] + 2.6);
        det += 'M' + pt(mv(J.fA.S, J.fwdUp, -14)) + 'L' + pt(mv(J.fA.S, J.fwdUp, 14));
