      const keys = Object.keys(target).filter(k => typeof target[k] === 'number');
      const discrete = new Set(['nHand', 'fHand', 'farFront']);
      if (!(ms > 0) || Director.reduced) { keys.forEach(k => this.p[k] = target[k]); this.render(); done && done(); return this; }
      this._tw = tween(ms, (e, raw) => {
        keys.forEach(k => { this.p[k] = discrete.has(k) ? (raw < .5 ? from[k] : target[k]) : lerp(from[k] ?? target[k], target[k], e); });
