        for (const Lg of [J.nL, J.fL]) for (const t2 of [.45, .75]) { const m = mix(Lg.H, Lg.K, t2); det += 'M' + pt(mv(m, Lg.a1 + 90, lr[0])) + 'L' + pt(mv(m, Lg.a1 - 90, lr[0])); }
      }
      /* a point on the chest surface: the front edge in profile, the centre line when facing us */
      const chest = (d, k = 1) => { const [f, b] = row(B.trunk.find(r => r[0] >= d) || B.trunk[B.trunk.length - 1]); return mix(f, mix(f, b, .5), st * k); };
      if (c.shirt && !c.collar) {
        const top = chest(181), low = chest(118), w = lerp(10, 22, st);
        const a = mv(top, J.fwdUp + 90, 0), l1 = mv(top, J.fwdUp, -w), r1v = mv(top, J.fwdUp, st > .5 ? w : 4);
        det2 = 'M' + pt(l1) + 'L' + pt(low) + 'L' + pt(r1v) + 'Z';
        if (c.tie) det2 += 'M' + pt(mv(top, J.spUp, -8)) + 'L' + pt(mv(mix(top, low, .7), J.fwdUp, -3)) + 'L' + pt(mv(mix(top, low, .7), J.fwdUp, 3)) + 'Z';
