        const sc = hk * 1.0;
        set('p-hat', blob(L2(HAT_P, HAT_F).map(([x, y]) => hf([x * sc / hk, y * sc / hk]))));
        set('p-band', blob(L2(BAND_P, BAND_F).map(([x, y]) => hf([x * sc / hk, y * sc / hk]))));
      } else { set('p-hat', ''); set('p-band', ''); }
      q['p-hat'].style.opacity = q['p-band'].style.opacity = clamp(p.hat, 0, 1);
      /* sunglasses */
      if (c.shades) {
        set('p-shP', blob([[15, -12], [38, -11], [38.5, -3], [31, 2], [17, 0]].map(([x, y]) => ht([x * hk, y * hk]))) + limb(ht([16 * hk, -9 * hk]), ht([-8 * hk, -6 * hk]), 1.4, 1.2));
        set('p-shF', blob([[3, -12], [27, -12], [27, -2], [19, 3], [5, 0]].map(([x, y]) => ht([x * hk, y * hk]))) + blob([[-3, -12], [-27, -12], [-27, -2], [-19, 3], [-5, 0]].map(([x, y]) => ht([x * hk, y * hk]))));
        q['p-shP'].style.opacity = 1 - sstep(.35, .7, st); q['p-shF'].style.opacity = sstep(.35, .7, st);
      }
