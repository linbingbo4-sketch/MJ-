        hair += blob([[x - 10, -26], [x + 10, -22], [x + 14, 30], [x + 12, 92], [x + 2, 108], [x - 10, 98], [x - 16, 50], [x - 16, 0]].map(([u, v]) => ht([u * hk, v * hk])));
      });
      if (hs.fore && !(p.hat > .01 && c.hat)) hair += limb(ht([26 * hk, -36 * hk]), ht([34 * hk, -14 * hk]), 4 * hk, 2.4 * hk, { p: 4 * hk, tp: .5 });
      set('p-hair', hair);
