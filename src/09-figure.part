      /* sparkle: the glove, the socks and the sequins */
      const tw = q['p-tw'], spots = [];
      if (c.glove && p.glove > .01) { const tr = frame(J.nA.W, J.nA.a3), k = B.hand / 62; spots.push(tr([24 * k, -4 * k]), tr([44 * k, 2 * k]), tr([12 * k, 6 * k])); }
      if (c.sock && this.styl !== 'line') for (const Lg of [J.nL, J.fL]) spots.push(mix(Lg.K, Lg.A, .93));
      if (c.sequins && this.styl !== 'line') { const [f1] = row([150, 40, 36, 56]), [, k2] = row([90, 30, 30, 44]); spots.push(mix(f1, J.shC, .35), mix(k2, J.waist, .4), mix(J.nA.S, J.nA.E, .55)); }
      if (tw.childElementCount !== spots.length) {
