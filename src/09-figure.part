      tween(ms, (e) => { this.p.spin = from + e * 360 * turns; this.render(); }, ease.inOut, () => { this.p.spin = 0; this.render(); done && done(); });
      return this;
    }
    /* a frozen copy of the current silhouette, for stroboscopic trails */
    ghost(opacity = .2, color) {
      const g = h('g.fig-ghost', { opacity });
      const parts = this.q['fg-parts'].cloneNode(true);
      parts.removeAttribute('id'); parts.setAttribute('class', 'fg-ghost-parts');
      parts.querySelectorAll('[id]').forEach(e => e.removeAttribute('id'));
      parts.querySelectorAll('.p-aoA, .p-aoL, .p-tw, .p-fGlint, .p-nGlint').forEach(e => e.remove());
      parts.querySelectorAll('path').forEach(e => { if (e.getAttribute('fill') !== 'none') e.setAttribute('fill', color || this.ink); e.removeAttribute('stroke'); e.removeAttribute('clip-path'); e.removeAttribute('filter'); e.removeAttribute('class'); });
      g.append(parts);
      const root = this.el.querySelector('.fg-root');
      root.insertBefore(g, root.querySelector('.fg-fx'));
