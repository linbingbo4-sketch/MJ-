    }
    footScale(J) { return lerp(1, .36, Math.pow(J.st, 2)); }

    /* ── drawing ── */
    render() {
      const J = this.solve(), B = this.B, p = this.p, c = this.c, q = this.q, fs = B.fs;
      const set = (k, d) => { const e = q[k]; if (e) e.setAttribute('d', d || ''); };
      const st = J.st, ct = J.ct;
      /* trunk: rows projected for the turn (an ellipse seen at angle th) */
      const row = ([d, fP, bP, hF]) => {
        const c0 = d <= B.low ? mv(J.pelvis, J.spLo, d) : mv(J.waist, J.spUp, d - B.low);
        const k = clamp((d - (B.low - 24)) / 48, 0, 1), fa = lerp(J.spLo, J.spUp, k) - 90;
        return [mv(c0, fa, Math.hypot(hF * st, fP * ct)), mv(c0, fa, -Math.hypot(hF * st, bP * ct))];
      };
      const rowsFor = (from, to, flare, natural) => {
        const T = B.trunk, out = [], wide = T[1];
        const hang = (d) => { const k = clamp((wide[0] - d) / 50, 0, 1.6); return [d, wide[1] + flare * k * 1.1, wide[2] + flare * k, wide[3] + flare * k * 1.3]; };
        const at = (d) => {
          for (let i = 0; i < T.length - 1; i++) if (d >= T[i][0] && d <= T[i + 1][0]) { const t = (d - T[i][0]) / (T[i + 1][0] - T[i][0]); return [d, lerp(T[i][1], T[i + 1][1], t), lerp(T[i][2], T[i + 1][2], t), lerp(T[i][3], T[i + 1][3], t)]; }
          return d < T[0][0] ? T[0] : T[T.length - 1];
        };
        if (from < wide[0] && !natural) { out.push(hang(from)); if (from < wide[0] - 20) out.push(hang((from + wide[0]) / 2)); T.forEach(r => { if (r[0] >= wide[0] && r[0] <= to) out.push(r); }); }
        else { out.push(at(from)); T.forEach(r => { if (r[0] > from + 4 && r[0] <= to) out.push(r); }); }
        /* a jacket sits loose over the hips */
        if (!natural) return out.map(([d, f, b, w]) => { const k = clamp((44 - d) / 44, 0, 1) * 4.5; return [d, f + k, b + k, w + k * .8]; });
        return out;
      };
      const shapeTrunk = (rows, flatBottom) => {
        const F = [], K = [];
        rows.forEach(r => { const [f, k] = row(r); F.push(f); K.push(k); });
        K.reverse();
        if (!flatBottom) return blob(F.concat(K));
        return 'M' + pt(F[0]) + crv(F) + 'L' + pt(K[0]) + crv(K) + 'Z';
      };
      const hem = c.hem ?? -30;
      set('p-hips', shapeTrunk(rowsFor(-34, 40, 0, true), false));
      set('p-torso', shapeTrunk(rowsFor(hem, 999, c.tee ? 0 : 3), true));
      set('p-seq', c.sequins ? shapeTrunk(rowsFor(hem, 999, 3), true) : '');
      /* arms */
      const r = B.armR;
      const armD = (A) => circle(A.S, r[0] + 2.4) + limb(A.S, A.E, r[0], r[1], { n: 2, tn: .45, p: 1.2, tp: .35 }) + limb(A.E, A.W, r[1], r[2] + (c.cuff ? 1.4 : 0), { p: 2, tp: .3, n: 1, tn: .25 });
      const handD = (A, kind) => {
        const pts = HANDS[HAND_KEYS[Math.round(kind) || 0]] || HANDS.open, k = B.hand / 62;
        const tr = frame(A.W, A.a3);
        return blob(pts.map(([x, y]) => tr([x * k, y * k])));
      };
      const ff = !!(p.farFront > .5);
      set(ff ? 'p-fArm2' : 'p-fArm', armD(J.fA)); set(ff ? 'p-fArm' : 'p-fArm2', '');
      set(ff ? 'p-fHand2' : 'p-fHand', handD(J.fA, p.fHand)); set(ff ? 'p-fHand' : 'p-fHand2', '');
      set('p-nArm', armD(J.nA)); set('p-nHand', handD(J.nA, p.nHand));
      if (this.styl === 'costume') { const ao = armD(J.nA) + handD(J.nA, p.nHand); set('p-aoA', ao); q['p-aoA'].setAttribute('transform', `translate(${5 * this.face} 6)`); }
      /* legs */
      const lr = B.legR, fx = this.footScale(J);
      const legD = (L) => {
        const thigh = limb(L.H, L.K, lr[0], lr[1], { p: 2.4, tp: .3, n: 3.4, tn: .18 });
        const hemT = c.bell ? 1.0 : (c.sock ? .84 : .97), hemP = mix(L.K, L.A, hemT);
        const hemR = c.bell ? lr[1] * 1.7 : lr[1] * .93;
        const shin = limb(L.K, hemP, lr[1], hemR, c.bell ? { flat: true, n: -1, p: -1 } : { n: 2.2, tn: .32, p: .6, tp: .3, flat: true });
        const sock = c.sock ? limb(hemP, mix(L.K, L.A, 1.04), lr[2] * 1.02, lr[2] * .98) : '';
        return { pants: thigh + shin, sock };
      };
      const shoeD = (L) => { const tr = frame(L.A, L.fa, fx); return blob(SHOE.map(([x, y]) => tr([x * fs, y * fs]))); };
      const glintD = (L) => { const tr = frame(L.A, L.fa, fx); return 'M' + pt(tr([24 * fs, -.5 * fs])) + 'Q' + pt(tr([46 * fs, 4 * fs])) + ' ' + pt(tr([66 * fs, 12 * fs])); };
      const nLeg = legD(J.nL), fLeg = legD(J.fL);
      set('p-fLeg', fLeg.pants); set('p-fSock', fLeg.sock); set('p-fShoe', shoeD(J.fL)); set('p-fGlint', glintD(J.fL));
      if (this.styl === 'costume') { set('p-aoL', nLeg.pants); q['p-aoL'].setAttribute('transform', `translate(${5 * this.face} 5)`); }
      set('p-nLeg', nLeg.pants); set('p-nSock', nLeg.sock); set('p-nShoe', shoeD(J.nL)); set('p-nGlint', glintD(J.nL));
      /* neck + head */
      const hk = J.hk, ht = frame(J.headC, J.faceA);
      const L2 = (P, F) => P.map((a, i) => [lerp(a[0], F[i][0], st) * hk, lerp(a[1], F[i][1], st) * hk]);
      set('p-neck', limb(J.neckB, J.neckT, B.neckR, B.neckR * .94));
      set('p-head', blob(L2(HEAD_P, HEAD_F).map(ht)));
      /* hair */
      const hs = HAIR[c.hair] || HAIR.jheri;
      let hair = '';
      if (hs.cap) {
        const [xP, yP, rxP, ryP, xF, yF, rxF, ryF] = hs.cap;
        const cc = ht([lerp(xP, xF, st) * hk, lerp(yP, yF, st) * hk]), rx = lerp(rxP, rxF, st) * hk, ry = lerp(ryP, ryF, st) * hk;
        const E = []; for (let i = 0; i < 20; i++) { const a = i / 20 * TAU; E.push(frame(cc, J.faceA)([Math.cos(a) * rx, Math.sin(a) * ry])); }
        hair += blob(E);
      }
      (hs.curls || []).forEach(([xP, yP, xF, yF, rr]) => { hair += circle(ht([lerp(xP, xF, st) * hk, lerp(yP, yF, st) * hk]), rr * hk); });
      if (hs.afro) {
        const k = hs.afro, o = [-14, -36];
        const P = AFRO_P.map((a, i) => { const b = AFRO_F[i]; return [(o[0] + (lerp(a[0], b[0], st) - o[0]) * k) * hk, (o[1] + (lerp(a[1], b[1], st) - o[1]) * k) * hk]; });
        hair += blob(P.map(ht));
        for (let i = 1; i < 14; i++) hair += circle(ht(P[i]), 9 * k * hk);
      }
      if (hs.curtains) hs.curtains.forEach(([xP, , xF]) => {
