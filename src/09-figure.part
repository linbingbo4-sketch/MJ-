    }
    pose(name, extra) { this.stop(); Object.assign(this.p, this.poseOf(name, extra)); this.render(); return this; }
    /* a list of [pose, ms, holdMs] played in order; returns a stopper */
    seq(list, { loop = false, done } = {}) {
      this.stop();
      if (Director.reduced) { const last = [...list].reverse().find(e => typeof e[0] !== 'function'); if (last) this.to(last[0], 0); done && done(); return () => {}; }
      let i = 0, alive = true, tm = 0;
      const next = () => {
        if (!alive) return;
        if (i >= list.length) { if (loop) i = 0; else { done && done(); return; } }
        const [ps, ms = 600, hold = 0, ez] = list[i++];
        if (typeof ps === 'function') { ps(this); tm = setTimeout(next, hold); return; }
        const target = typeof ps === 'string' ? this.poseOf(ps) : Object.assign({}, this.p, ps);
        const from = Object.assign({}, this.p);
        const keys = Object.keys(target).filter(k => typeof target[k] === 'number');
        this._tw = tween(ms, (e, raw) => { keys.forEach(k => { this.p[k] = (k === 'nHand' || k === 'fHand') ? (raw < .5 ? from[k] : target[k]) : lerp(from[k] ?? target[k], target[k], e); }); this.render(); }, ez || ease.inOut, () => { tm = setTimeout(next, hold); });
      };
