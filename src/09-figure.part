      }
      [...tw.children].forEach((g, i) => { const s2 = spots[i]; g.setAttribute('transform', `translate(${r1(s2[0])} ${r1(s2[1])}) scale(${r1(B.hand / 62 * (i < 3 && c.glove ? 1 : .8) * 10) / 10})`); g.style.opacity = i < 3 && c.glove ? clamp(p.glove, 0, 1) : 1; });
