      q['fg-pool'].setAttribute('cx', r1(footX + 10)); q['fg-pool'].setAttribute('rx', r1(130 * (B === CHILD ? .8 : 1) + Math.abs(J.nL.A[0] - J.fL.A[0]) * .5));
      if (this.shadow === 'cast') q['fg-cast'].setAttribute('transform', `matrix(1 0 ${this.castK} ${this.castS} 0 0)`);
      /* facing mirrors about the figure's origin; a spin squeezes it about its own centre line */
      const c0 = Math.cos((p.spin || 0) * RAD), cx0 = J.pelvis[0];
      const tf = (this.face < 0 ? 'scale(-1 1) ' : '') + (Math.abs(c0 - 1) < 1e-3 ? '' : `translate(${r1(cx0 * (1 - c0))} 0) scale(${Math.round(c0 * 1000) / 1000} 1)`);
      q['fg-root'].setAttribute('transform', tf.trim());
      if (this._hit) this._hit.setAttribute('x', r1(J.pelvis[0] - this._hitW / 2));
