      if (this._cyc) { this._cyc(); this._cyc = null; }
      if (this.ik) { this.ik = null; }
    }
    /* the backslide: a toe-planted foot holds still while the flat foot glides back; the body drifts backward */
    moonwalk({ steps = 4, stride = 64, stepMs = 620, onStep, done, frame: atT, x0: from } = {}) {
      this.stop();
      const B = this.B, fs = B.fs, x0 = from ?? (this.p.x || 0);
      Object.assign(this.p, this.poseOf('stand', { x: x0, lean: 5, chest: 2, neck: 6, turn: .14, nSh: 8, nEl: 34, nWr: 6, fSh: -6, fEl: 28, nHand: HI('open'), fHand: HI('flat'), hat: this.p.hat, glove: this.p.glove }));
      const ball = 52 * fs, sole = 28.5 * fs, TOE = 52;
      const ankleFromBall = (bx, fa) => { const X = [sn(fa), cs(fa)], Y = [-X[1], X[0]]; return [bx - X[0] * ball - Y[0] * sole, 0 - X[1] * ball - Y[1] * sole]; };
      const hipY = -H0(B) + 18;
      const total = steps * stepMs;
      const P0 = x0 + 4 * fs + 6;
      const pose = (t) => {
        const k = Math.min(t, total - 1e-6) / stepMs, step = Math.floor(k), ph = k - step;
        const P = P0 - stride * step;                                   /* ball of the planted foot this step */
        const sw = sstep(.82, 1, ph);                                   /* end-of-step heel switch */
        const plantFa = lerp(TOE, 90, sw), slideFa = lerp(90, TOE, sw);
        const slideStart = P + stride - ball, slideEnd = P - stride - ball;
        const sx = lerp(slideStart, slideEnd, Math.min(1, ph / .82));
        const slideA = sw > 0 ? ankleFromBall(slideEnd + ball, slideFa) : [sx, -sole];
        const plantA = ankleFromBall(P, plantFa);
        const plantKey = step % 2 === 0 ? 'n' : 'f', slideKey = plantKey === 'n' ? 'f' : 'n';
        const bodyX = P - 2 * fs - stride * ph + 8;
        this.ik = { pelvis: [bodyX, hipY + Math.sin(ph * TAU) * 2.5], [plantKey]: { A: plantA, fa: plantFa }, [slideKey]: { A: slideA, fa: slideFa } };
        this.p.x = bodyX;
        this.p.nSh = 8 + Math.sin(k * Math.PI) * 10; this.p.fSh = -6 - Math.sin(k * Math.PI) * 9;
        this.render();
