      const sc = this.el.closest('.scene'); if (!sc || !sc.classList.contains('active')) return;
      const r = this.el.getBoundingClientRect(), sr = $('#stage').getBoundingClientRect();
      const pan = sr.width ? ((r.left + r.width / 2 - sr.left) / sr.width - .5) * 1.3 : 0;
