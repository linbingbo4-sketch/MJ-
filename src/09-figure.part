    }

    /* ── motion ── */
    set(p) { Object.assign(this.p, p); this.render(); return this; }
    poseOf(name, extra) { return Object.assign({}, BASE, { x: this.p.x }, POSES[name] || {}, extra || {}); }
    /* tween to a pose (name or object); hands switch at the midpoint */
    to(pose, ms = 900, ez = ease.inOut, done) {
