          const s = (u - .5) * 2;
          return { A: [bodyX + dir * stride * (-1 + s * 2) * .5, -sole - Math.sin(s * Math.PI) * 22 * fs], fa: 90 - Math.sin(s * Math.PI) * 14 };
        };
        this.ik = { pelvis: [bodyX, hipY - Math.abs(Math.cos(ph * TAU)) * 4], n: foot(0), f: foot(.5) };
        this.p.x = bodyX;
        const sw = Math.sin(ph * TAU);
