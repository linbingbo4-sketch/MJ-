      let det = '', det2 = '', nDet = '';
      const onArm = (A, t, w) => { const m = mix(A.S, A.E, t), a = mv(m, A.a1, -w), b = mv(m, A.a1, w), rr = lerp(r[0], r[1], t) + 1.6; return 'M' + [mv(a, A.a1 + 90, rr), mv(b, A.a1 + 90, rr), mv(b, A.a1 - 90, rr), mv(a, A.a1 - 90, rr)].map(pt).join('L') + 'Z'; };
      if (c.chevron) {
        for (const A of [J.nA, J.fA]) for (const t2 of [.28, .48]) { const m = mix(A.S, A.E, t2); det += 'M' + pt(mv(m, A.a1 + 90, r[0] * .98)) + 'L' + pt(mv(mix(A.S, A.E, t2 + .1), A.a1, 0)) + 'L' + pt(mv(m, A.a1 - 90, r[0] * .98)); }
        const [f1] = row([170, 40, 36, 56]), [f2] = row([120, 35, 31, 49]);
