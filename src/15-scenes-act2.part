      A('div.h-s.center.nowrap', 1380, 880, { show: '0-0', d: 1.6, style: 'color:var(--acc2)' }, T(L('튀어 올라, 그대로 멈추다', '弹出，然后定住'))));
    clickable(this.st.hitbox(260), () => { if (this.i === 0) this.st.seq([[{ neck: -7, head: 0 }, 1800], [{ head: 14 }, 900, 400], [{ head: 0 }, 900]]); });
