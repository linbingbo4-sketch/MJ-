    const [sx, sy] = g ? P(g.stadium) : [767, 579];
    const [ax, ay] = g ? P(g.assembly) : [369, 528];
    this.stad = h('div.pin', { style: { left: sx + 'px', top: sy + 'px' } }, h('div.pin-dot'), h('div.pin-l', {}, T(L('잠실 올림픽 주경기장', '蚕室奥林匹克主体育场')), h('small', { text: 'JAMSIL' })));
    this.asm = h('div.pin.blue', { style: { left: ax + 'px', top: ay + 'px' } }, h('div.pin-dot'), h('div.pin-l', { style: { left: '-28px', translate: '-100% 0', textAlign: 'right' } }, T(L('국회 · 1998. 2. 25', '国会 · 1998年2月25日')), h('small', {}, T(L('김대중 대통령 취임식', '金大中总统就职典礼')))));
    this.stad.classList.add('rv'); this.asm.classList.add('rv', 'drop');
    this.map.append(this.stad, this.asm);
    back.append(this.map);
    mid.append(A('div.se-and', 150, 214, { anchor: 'ay', show: '0-0', cls: 'left', d: .2 }, T(L('그리고,', '还有，'))),
      A('div.se-v', 150, 600, { anchor: 'ay', show: '0-0', cls: 'blur slow', d: .4 }, T(L('서울', '首尔'))),
      A('div.lab.se-y', 400, 960, { anchor: 'ay', show: '0-0', d: 1.4 }, '1996 — 1999'));
    const ticket = (o) => h('div.ticket', {},
      h('div.tk-main', {}, h('div.tk-k', { text: o.k }), h('div.tk-e', { text: o.e }), h('div.tk-v', {}, T(o.v)), h('div.tk-d', { text: o.d }), h('div.tk-seal', { html: o.seal })),
      h('div.tk-stub', {}, h('span', { text: 'ADMIT ONE' })));
    this.tk1 = ticket({ k: 'MICHAEL JACKSON', e: 'HISTORY WORLD TOUR · SEOUL', v: L('잠실 올림픽 주경기장 · 첫 내한 공연', '蚕室奥林匹克主体育场 · 首次访韩演出'), d: '1996. 10. 11 · 13', seal: "SEOUL<br>'96" });
    this.tk2 = ticket({ k: 'MJ & FRIENDS', e: 'BENEFIT CONCERT · SEOUL', v: L('잠실 올림픽 주경기장 · 자선 공연', '蚕室奥林匹克主体育场 · 慈善演出'), d: '1999. 6. 25', seal: "SEOUL<br>'99" });
    this.t1 = A('div', 1360, 300, { cls: 'rv right slow', style: 'rotate:-3deg' }, this.tk1);
    this.t2 = A('div', 1300, 470, { cls: 'rv right slow', style: 'rotate:2deg' }, this.tk2);
    mid.append(this.t1, this.t2);
    /* 1 · 430 tons, and a tank on the stage */
    back.append(A('div.tankbox', 1260, 860, { show: '1-1', cls: 'right slow', d: .3, html: tankSVG() }));
    this.eman = stageFig(stg, { costume: 'person', style: 'costume', x: 700, y: 990, h: 560, show: '1-1', d: .5, glowPx: 7, rim: '#d6e4ff', glow: 'rgba(170, 200, 255, .4)', c: { jacket: '#e7e2d8', pants: '#14161c' },
      p: { turn: .3, neck: -6, nSh: 100, nEl: 10, nHand: Figure.HI('open'), fSh: 76, fEl: 12, fHand: Figure.HI('open'), nHip: 14, nKnee: 10, fHip: -10, fKnee: 4 } });
    mid.append(A('div.se-430', 150, 300, { anchor: 'ay', show: '1-1', d: .8 }, '430'),
      stack(160, 470, { anchor: 'ay', align: 'left', gap: 12 },
        R('b-m', '1-1', 1.1, T(L('톤 — 무대 장비', '吨——舞台设备'))),
        R('b-m', '1-1', 1.6, T(L('〈Earth Song〉엔 실물 크기 탱크', '《Earth Song》里，真实大小的坦克')), 'up', { color: 'var(--dim)' }),
        R('', '1-1', 2.2, mvSwitch('earth'), 'up', { marginTop: '10px' })),
      A('div.h-s.center.nowrap', 1300, 860, { show: '3', d: 1.4, style: 'color:var(--acc2)' }, T(L('이 날짜를, 기억해 주세요', '请记住这个日期'))));
    /* interaction: tear the stub off the 1996 ticket */
    tiltify(this.tk1, 8);
    const stub = $('.tk-stub', this.tk1);
    let torn = false;
    draggable(stub, {
      move: (x, y, dx, dy) => { if (torn) return; const d = clamp(dx, 0, 220); stub.style.transform = `translate(${d}px, ${Math.max(0, dy) * .3}px) rotate(${d * .08}deg)`; },
      up: () => {
        const m = /translate\(([\d.]+)px/.exec(stub.style.transform || ''); const d = m ? +m[1] : 0;
        if (d > 90) { torn = true; stub.style.transition = 'transform .9s cubic-bezier(.5,0,.75,0), opacity .9s ease'; stub.style.transform = 'translate(260px, 520px) rotate(38deg)'; stub.style.opacity = 0; }
        else { stub.style.transition = 'transform .5s var(--e-drop)'; stub.style.transform = ''; setTimeout(() => { stub.style.transition = ''; }, 520); }
      },
    });
    this.resetStub = () => { torn = false; stub.style.transition = 'none'; stub.style.transform = ''; stub.style.opacity = ''; void stub.offsetWidth; stub.style.transition = ''; };
    mid.append(itip(1600, 470, L('꼬리표를 오른쪽으로 끌어 보세요', '把票根往右拖，撕下来'), '1-1'));
  },
  beat(i, ctx) {
    this.i = i;
    this.eman.stop();
    if (i !== 1) this.resetStub();
    this.map.classList.toggle('dimmed', i === 1 || i === 3);
    vis(this.map, 'on');
    this.map.classList.toggle('on', true);
    if (i === 0 && ctx.fwd) { this.map.classList.remove('on'); void this.map.offsetWidth; this.map.classList.add('on'); }
    vis(this.stad, 'on');
    vis(this.asm, i === 2 ? 'on' : 'off');
    vis(this.t1, i === 1 || i === 3 ? 'on' : 'off');
    this.t1.style.top = (i === 3 ? 390 : 300) + 'px';
    this.tk1.classList.toggle('back', i === 3);
    vis(this.t2, i === 3 ? 'on' : 'off');
    this.tk2.classList.toggle('glow', i === 3);
    if (i === 0) ctx.light({ lights: [{ id: 'm', x: 1180, y: 560, rx: 640, ry: 470, soft: .6, i: .85 }, { id: 's', x: 1180 - 525 + 767, y: 560 - 432 + 579, rx: 150, ry: 130, soft: .3 }, { id: 't', x: 330, y: 560, rx: 330, ry: 460, soft: .5 }] });
    if (i === 1) ctx.light({ lights: [{ id: 'm', x: 900, y: 560, rx: 560, ry: 420, soft: .7, i: .35 }, { id: 'k', x: 1360, y: 300, rx: 470, ry: 230, soft: .3 }, { id: 'n', x: 420, y: 420, rx: 420, ry: 240, soft: .5 }, { id: 'e', x: 980, y: 800, rx: 640, ry: 300, soft: .35, col: '#b8ccff' }] });
    if (i === 2) ctx.light({ lights: [{ id: 'm', x: 1180, y: 560, rx: 640, ry: 470, soft: .6, i: .85 }, { id: 'p', x: 1180 - 525 + 369, y: 560 - 432 + 528, rx: 260, ry: 140, soft: .35 }] });
    if (i === 3) ctx.light({ lights: [{ id: 'm', x: 900, y: 560, rx: 560, ry: 420, soft: .7, i: .35 }, { id: 'k', x: 1300, y: 470, rx: 480, ry: 240, soft: .28 }, { id: 'n', x: 1300, y: 860, rx: 420, ry: 90, soft: .5, cone: false }] });
  },
  leave() { this.eman.stop(); },
});
</script>
