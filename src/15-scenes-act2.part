        h('div.fr-b'), h('div.fr-c.tl'), h('div.fr-c.tr'), h('div.fr-c.bl'), h('div.fr-c.br'),
        h('div.fr-in', {}, h('div.fr-k', {}, T(L('1992 · 공식 공연 영상', '1992 · 官方演出影像'))), h('div.fr-t', { text: 'Live in Bucharest' }), h('div.b-m', { style: { color: 'var(--dim)' } }, T(L('〈Jam〉 직전, 오프닝', '《Jam》之前的开场'))))),
      A('div.bk-frame-cap', 960, FR.y + FR.h + 70, { show: '1-1', d: .8 }, h('span.lab', { text: 'LIVE IN BUCHAREST · THE DANGEROUS TOUR' }), h('span.lab', {}, T(L('마이클 잭슨 공식 채널', '迈克尔·杰克逊官方频道')))));
