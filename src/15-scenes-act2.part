        h('div.fr-in', {}, h('div.fr-k', {}, T(L('그날의 관객석', '那天的观众席'))), h('div.fr-t', { text: 'Bucharest · 1992' }))),
      A('div.lab.nowrap', WR.x + WR.w / 2, WR.y + WR.h + 52, { show: '4', d: .6 }, T(L('공식 공연 영상 · 소리 없이 반복', '官方演出影像 · 静音循环'))),
      this.last = A('div.h-s.center.nowrap', WR.x + WR.w / 2, 872, { show: '4', d: 1.6, style: 'color:var(--acc2)' }, T(L('그동안 그는, 아무것도 하지 않았다', '这段时间里，他什么都没做'))));
  },
  pop(on, ctx) {
    clearTimeout(this._pop);
    const box = this.st.box;
    if (!on) { box.classList.remove('up'); return; }
    if (!ctx.fwd) { box.classList.add('up'); return; }
    box.classList.remove('up'); void box.offsetWidth;
    this._pop = setTimeout(() => {
      box.classList.add('up'); this.hatch.classList.add('flash'); SFX.boom(.4);
      setTimeout(() => this.hatch.classList.remove('flash'), 260);
    }, ctx.say('튀어', .2));
  },
  beat(i, ctx) {
    this.i = i;
    this.st.stop();
    const beams = (k) => [
      { id: 'b1', type: 'beam', x: 140, y: -80, ang: 62, spread: 8, len: 1350, i: .7 * k }, { id: 'b2', type: 'beam', x: 640, y: -100, ang: 82, spread: 7, len: 1300, i: .55 * k },
      { id: 'b3', type: 'beam', x: 1280, y: -100, ang: 98, spread: 7, len: 1300, i: .55 * k }, { id: 'b4', type: 'beam', x: 1780, y: -80, ang: 118, spread: 8, len: 1350, i: .7 * k }];
    this.pop(i === 0, ctx);
    if (i === 0) {
      this.st.pose('statue');
      ctx.fx({ gold: .6, crowd: 1 });
      ctx.light({ ambient: .84, lights: [...beams(.85), { id: 'a', x: 560, y: 600, rx: 340, ry: 440, soft: .2, delay: ctx.fwd ? ctx.say('튀어', .2) / 1000 : 0 },
        { id: 't', x: 1380, y: 560, rx: 520, ry: 420, soft: .5, i: .85 }, textLight('k', this.k90, { i: .6, delay: ctx.fwd ? .9 : 0 })] });
    }
    if (i === 1) {
      ctx.fx({ gold: .3, crowd: .6 });
      ctx.light({ warm: .45, lights: [{ id: 'f', type: 'rect', x: 960, y: 467, w: 1280, h: 755, r: 6, soft: 60, i: .95 }, { id: 'c', x: 960, y: 900, rx: 640, ry: 90, soft: .5, i: .8, cone: false }] });
    }
    if (i === 2 || i === 3) {
      ctx.fx({ gold: .3, crowd: .4 });
      ctx.light({ ambient: .8, lights: [{ id: 'l', type: 'rect', x: 1180, y: 540, w: 1340, h: i === 2 ? 520 : 760, r: 10, soft: 70, i: .9 }, ...photoLight('ph', this.ph, { delay: ctx.fwd && i === 2 ? .4 : 0 })] });
    }
    if (i === 4) {
      ctx.fx({ gold: .5, crowd: 1 });
      const cfg = Settings.get().videos.bucharest || {}, a = cfg.start != null ? +cfg.start + 6 : 0;
      const pip = Video.slot('pip'); pip.el.classList.add('wall');
      Video.playRange('pip', 'bucharest', { start: a, end: a + 50, muted: true, loop: true, rect: Scenes.rect('bkWall') });
      ctx.light({ ambient: .82, lights: [{ id: 'w', type: 'rect', x: 1200, y: 475, w: 1040, h: 620, r: 6, soft: 60, i: .95 }, ...photoLight('ph', this.ph), textLight('x', this.last, { i: .7, delay: ctx.fwd ? 1.6 : 0 })] });
    } else { Video.stop('pip'); Video.slot('pip').el.classList.remove('wall'); }
  },
  leave() { clearTimeout(this._pop); this.st.stop(); Video.slot('pip').el.classList.remove('wall'); },
});
</script>
