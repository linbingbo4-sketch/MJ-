      row('', '2-3', .2, 'BUCUREȘTI', '1992. 10', '90,000', none(L('공식 집계 없음', '没有官方统计')), L('HBO 중계: “울다 실신하는 관객이 끝없이” — Variety', 'HBO 转播：「哭泣、晕倒的观众镜头接连不断」——Variety')),
