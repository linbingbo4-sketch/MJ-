<style>
/* ── accents: a small moment with sound after every third sentence ── */
#stage > #accent { position: absolute; inset: 0; pointer-events: none; z-index: 7; overflow: hidden; contain: strict; }
#accent > * { position: absolute; pointer-events: none; }
.ac-flash { inset: 0; background: #fff; opacity: 0; animation: acFlash .42s ease-out forwards; }
.ac-flash.blue { background: #cfe0ff; }
@keyframes acFlash { 0% { opacity: .62; } 100% { opacity: 0; } }
.ac-beam { top: -10%; left: 0; width: 360px; height: 120%; background: linear-gradient(90deg, transparent, rgba(255, 244, 220, .2) 40%, rgba(255, 250, 235, .34) 50%, rgba(255, 244, 220, .2) 60%, transparent); rotate: 12deg; translate: -500px 0; animation: acBeam 1.15s cubic-bezier(.45, 0, .25, 1) forwards; }
#stage:not(.q-low) .ac-beam { mix-blend-mode: screen; }
@keyframes acBeam { to { translate: 2300px 0; } }
.ac-star { width: 0; height: 0; font: 400 var(--s, 40px)/1 var(--f-num); color: var(--c, #ffe6a8); text-shadow: 0 0 14px rgba(255, 220, 140, .9); }
.ac-star::before { content: '✦'; position: absolute; translate: -50% -50%; animation: acStar .95s cubic-bezier(.2, .8, .3, 1) var(--dl, 0s) both; }
@keyframes acStar { 0% { scale: 0; rotate: -40deg; opacity: 0; translate: -50% -50%; } 30% { opacity: 1; } 100% { scale: 1; rotate: 30deg; opacity: 0; translate: calc(-50% + var(--dx)) calc(-50% + var(--dy)); } }
.ac-dot { width: 18px; height: 18px; border-radius: 50%; background: radial-gradient(circle, #fff 0 25%, rgba(255, 236, 190, .7) 40%, transparent 70%); animation: acDot 1.3s ease-in-out var(--dl, 0s) both; }
@keyframes acDot { 0% { opacity: 0; translate: 0 0; } 25% { opacity: 1; } 100% { opacity: 0; translate: var(--dx) var(--dy); } }
.ac-word { font: italic 700 64px/1 var(--f-en); color: #fff7e0; text-shadow: 0 0 22px rgba(255, 200, 120, .8), 0 4px 0 rgba(0, 0, 0, .35); white-space: nowrap; translate: -50% -50%; animation: acWord 1.1s cubic-bezier(.2, 1.6, .4, 1) both; }
@keyframes acWord { 0% { scale: .2; rotate: -14deg; opacity: 0; } 25% { opacity: 1; } 70% { scale: 1; rotate: -6deg; opacity: 1; } 100% { scale: 1.08; rotate: -6deg; opacity: 0; } }
.ac-conf { width: 12px; height: 18px; top: -30px; background: var(--c); animation: acConf var(--t, 2.2s) cubic-bezier(.3, .2, .6, 1) var(--dl, 0s) both; }
@keyframes acConf { 0% { translate: 0 0; rotate: 0deg; opacity: 1; } 100% { translate: var(--dx) 1180px; rotate: var(--r); opacity: .9; } }
.ac-icon { width: 120px; height: 120px; translate: -50% -50%; animation: acIcon 1.1s ease-out both; }
.ac-icon svg { width: 100%; height: 100%; }
@keyframes acIcon { 0% { opacity: 0; scale: .5; } 20% { opacity: 1; scale: 1; } 40% { rotate: -14deg; } 55% { rotate: 12deg; } 70% { rotate: -8deg; } 100% { opacity: 0; rotate: 0deg; scale: 1.05; } }
#scenes.ac-shake { animation: acShake .32s steps(2) 2; }
@keyframes acShake { 0% { translate: 6px 0; } 50% { translate: -6px 0; } 100% { translate: 0 0; } }
</style>

<script>
/* ═══ ACCENTS — after every third sentence of the script, something small happens on stage, with a sound ═══
   The kind follows the era (a tambourine in Gary, glints off a mirror ball in Off the Wall, thunder in Thriller,
   a finger snap in Bad, camera flashes on tour, confetti for the legacy), and the words: a sentence with a number
   gets sparkles on the number on screen, one about a first or a record gets a camera flash.
   Quiet where the talk is serious (the shadow years, the death) and while a video plays. */
const Accents = (() => {
  const layer = h('div#accent', { 'aria-hidden': 'true' });
  $('#stage').append(layer);
  let count = 0;
  const turn = {};
  const KIT = {
    cold: ['sweep', 'heehee'], title: ['sparkle', 'sweep'], gary: ['tambourine', 'sparkle'], otw: ['disco', 'scratch'],
    thriller: ['thunder', 'sweep'], bad: ['snap', 'heehee'], dangerous: ['flash', 'sweep'], bucharest: ['flash', 'sparkle'],
    shadow: [], tii: ['sweep'], legacy: ['confetti', 'sparkle'], finale: ['sparkle', 'confetti'], cinema: [],
  };
  /* a record or a first → a camera flash; a count (not a year) → sparkles on the number */
  const KEYS = [[/처음|최초|역사상|사상 |신기록/, 'flash'], [/\d{1,3}(,\d{3})+|\d+\s*(만|억|위|명|곡|회|톤|배|%)/, 'sparkle']];
  const lite = () => Q.tier === 'low';
  const add = (el, ms) => { layer.append(el); setTimeout(() => el.remove(), ms); return el; };
  const rnd = (a, b) => a + Math.random() * (b - a);
  /* the most prominent visible text of the scene (a number when the sentence has one) */
  function target(preferNumber) {
    const sc = $('.scene.active'); if (!sc) return { x: 960, y: 420 };
    const cand = $$('.h-l, .h-m, .h-s, .led, .bk-90, .date625, .se-430, .num, .odo, .lg-v', sc).filter(e => e.closest('.rv') ? e.closest('.rv').classList.contains('on') : true)
      .map(e => ({ e, r: e.getBoundingClientRect() })).filter(o => o.r.width > 20 && o.r.height > 10);
    const num = preferNumber ? cand.filter(o => /\d/.test(o.e.textContent)) : [];
    const pick = (num.length ? num : cand).sort((a, b) => b.r.width * b.r.height - a.r.width * a.r.height)[0];
    if (!pick) return { x: 960, y: 420 };
    const st = $('#stage').getBoundingClientRect(), k = st.width / W;
    return { x: (pick.r.left + pick.r.width / 2 - st.left) / k, y: (pick.r.top + pick.r.height / 2 - st.top) / k, w: pick.r.width / k, h: pick.r.height / k };
  }
  const FX = {
    flash() { add(h('div.ac-flash'), 500); SFX.shutter(); },
    thunder() { add(h('div.ac-flash.blue'), 500); setTimeout(() => add(h('div.ac-flash.blue'), 500), 180); SFX.thunder(); },
    sweep() { add(h('div.ac-beam'), 1250); SFX.whoosh(1.1, .5, .16); },
    sparkle(num) {
      const t = target(num), n = lite() ? 7 : 12;
      for (let k = 0; k < n; k++) {
        const a = rnd(0, Math.PI * 2), r = rnd(60, 180);
        add(h('div.ac-star', { style: { left: (t.x + rnd(-(t.w || 200) / 2, (t.w || 200) / 2)) + 'px', top: (t.y + rnd(-30, 30)) + 'px', '--dx': Math.cos(a) * r + 'px', '--dy': Math.sin(a) * r * .6 + 'px', '--s': rnd(22, 46) + 'px', '--dl': (k * .04) + 's' } }), 1400);
      }
      SFX.chime();
    },
    tambourine() {
      add(h('div.ac-icon', { style: { left: '1720px', top: '860px' }, html: '<svg viewBox="0 0 100 100" fill="none" stroke="#ffd98a" stroke-width="5"><circle cx="50" cy="50" r="34"/>' + Array.from({ length: 6 }, (_, k) => { const a = k / 6 * Math.PI * 2; return `<circle cx="${50 + Math.cos(a) * 34}" cy="${50 + Math.sin(a) * 34}" r="7" fill="#f4e3b0" stroke="#b58a3a" stroke-width="2"/>`; }).join('') + '</svg>' }), 1200);
      FX.sparkle(false); SFX.tambourine();
    },
    disco() {
      const n = lite() ? 8 : 16;
      for (let k = 0; k < n; k++) add(h('div.ac-dot', { style: { left: rnd(100, 1800) + 'px', top: rnd(80, 700) + 'px', '--dx': rnd(-260, 260) + 'px', '--dy': rnd(-40, 120) + 'px', '--dl': rnd(0, .35) + 's' } }), 1800);
      SFX.chime({ gain: .2, notes: [2093, 2637, 3136, 2637] });
    },
    scratch() { const s = $('#scenes'); s.classList.remove('ac-shake'); void s.offsetWidth; s.classList.add('ac-shake'); setTimeout(() => s.classList.remove('ac-shake'), 700); SFX.scratch(); },
    snap() { const t = target(false); add(h('div.ac-word', { text: 'snap!', style: { left: Math.min(1700, t.x + (t.w || 300) / 2 + 60) + 'px', top: (t.y - 50) + 'px', fontSize: '54px' } }), 1200); SFX.snap(); setTimeout(() => SFX.snap(.4), 260); },
    heehee() { add(h('div.ac-word', { text: 'Hee-hee!', style: { left: rnd(1300, 1650) + 'px', top: rnd(240, 360) + 'px' } }), 1200); SFX.falsetto(.45); },
    confetti() {
      const n = lite() ? 18 : 40, C = ['#ffd98a', '#ff7a59', '#7ad0ff', '#f4f0e6', '#c9a0ff'];
      for (let k = 0; k < n; k++) add(h('div.ac-conf', { style: { left: rnd(40, 1880) + 'px', '--c': C[k % C.length], '--dx': rnd(-160, 160) + 'px', '--r': rnd(-540, 540) + 'deg', '--t': rnd(1.8, 2.8) + 's', '--dl': rnd(0, .4) + 's' } }), 3400);
      SFX.pop();
    },
  };
  function quiet(b) {
    return VIEW !== 'stage' || Director.reduced || !b || b.silent || b.noAccent || ['cut', 'cut6', 'video'].includes(b.mus) || (typeof MV !== 'undefined' && MV.isOpen)
      || (() => { const s = Video.status(); return s.playing && (s.slot === 'main' || s.slot === 'mv'); })();
  }
  function fire(b, text) {
    const sc = SCENES[b.scene], kit = KIT[sc.era] || [];
    if (!kit.length || quiet(b)) return null;
    let kind = null;
    for (const [re, k] of KEYS) if (re.test(text || '')) { kind = k; break; }
    if (!kind) { turn[sc.era] = ((turn[sc.era] ?? -1) + 1) % kit.length; kind = kit[turn[sc.era]]; }
    try { FX[kind](kind === 'sparkle' && KEYS[1][0].test(text || '')); } catch (e) { console.error(e); }
    return kind;
  }
  /* one sentence of the script has just appeared (only counted going forward) */
  function sentence(text, beat) { const b = BEATS[beat]; if (!b || b.silent) return null; count++; return count % 3 === 0 ? fire(b, text) : null; }
  return { sentence, fire, get count() { return count; }, reset() { count = 0; }, kinds: Object.keys(FX) };
})();
</script>
