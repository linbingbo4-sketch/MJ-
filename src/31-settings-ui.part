<style>
/* operator panels (real pixels) */
.op { --o-bg: #14110e; --o-bg2: #1c1814; --o-bg3: #26211b; --o-ink: #efe6d6; --o-dim: #a89c89; --o-line: rgba(239, 230, 214, .12); --o-acc: #ffcf87; --o-ok: #7fd49a; --o-warn: #f2c25c; --o-bad: #ff7b6e;
  color: var(--o-ink); font: 14px/1.5 var(--f-zh), var(--f-ko), system-ui, sans-serif; }
.op button, .op input, .op select, .op textarea { font: inherit; color: inherit; }
.op .btn { appearance: none; border: 1px solid var(--o-line); background: var(--o-bg3); padding: 7px 14px; border-radius: 8px; cursor: pointer; white-space: nowrap; transition: border-color .2s, background .2s; }
.op .btn:hover { border-color: rgba(255, 207, 135, .5); }
.op .btn:focus-visible, .op input:focus-visible, .op select:focus-visible, .op textarea:focus-visible { outline: 2px solid var(--o-acc); outline-offset: 1px; }
.op .btn.pri { background: var(--o-acc); color: #1a120a; border-color: var(--o-acc); font-weight: 600; }
.op .btn.sm { padding: 4px 10px; font-size: 12.5px; border-radius: 6px; }
.op input[type=text], .op input[type=number], .op select, .op textarea { background: #0e0c0a; border: 1px solid var(--o-line); border-radius: 6px; padding: 6px 9px; min-width: 0; }
.op input[type=number] { width: 84px; font-family: var(--f-mono); font-size: 13px; }
.op input[type=range] { accent-color: var(--o-acc); }
.op .chip { display: inline-flex; align-items: center; gap: 6px; padding: 2px 9px; border-radius: 999px; font-size: 12px; border: 1px solid var(--o-line); color: var(--o-dim); white-space: nowrap; }
.op .chip::before { content: ''; width: 7px; height: 7px; border-radius: 50%; background: currentColor; }
.op .chip.ok { color: var(--o-ok); border-color: rgba(127, 212, 154, .35); }
.op .chip.warn { color: var(--o-warn); border-color: rgba(242, 194, 92, .35); }
.op .chip.bad { color: var(--o-bad); border-color: rgba(255, 123, 110, .4); }
.op .chip.run { color: var(--o-acc); }
.op .mono { font-family: var(--f-mono); }
.op .muted { color: var(--o-dim); }
.op kbd { font-family: var(--f-mono); font-size: 12px; border: 1px solid var(--o-line); border-bottom-width: 2px; border-radius: 5px; padding: 1px 6px; background: var(--o-bg3); }
.op table { width: 100%; border-collapse: collapse; }
.op th, .op td { text-align: left; padding: 8px 10px; border-bottom: 1px solid var(--o-line); vertical-align: middle; }
.op th { font-weight: 500; color: var(--o-dim); font-size: 12.5px; }

.modal { position: fixed; inset: 0; display: grid; place-items: center; background: rgba(0, 0, 0, .55); backdrop-filter: blur(4px); padding: 16px; z-index: 60; }
.modal[hidden] { display: none; }
.sheet { width: min(1120px, 100%); max-height: min(88vh, 940px); display: flex; flex-direction: column; background: var(--o-bg); border: 1px solid var(--o-line); border-radius: 16px; box-shadow: 0 40px 120px rgba(0, 0, 0, .6); overflow: hidden; }
.sheet-h { display: flex; align-items: center; gap: 18px; padding: 16px 20px; border-bottom: 1px solid var(--o-line); }
.sheet-h h2 { margin: 0; font: 600 17px/1 var(--f-zh); letter-spacing: .02em; }
.sheet-h .x { margin-left: auto; }
.tabs { display: flex; gap: 4px; flex-wrap: wrap; }
.tabs button { appearance: none; border: 0; background: transparent; padding: 7px 12px; border-radius: 8px; cursor: pointer; color: var(--o-dim); }
.tabs button[aria-selected=true] { background: var(--o-bg3); color: var(--o-ink); }
.sheet-b { padding: 20px; overflow: auto; }
.sec { margin-bottom: 26px; }
.sec h3 { margin: 0 0 12px; font: 600 15px/1.3 var(--f-zh); }
.sec p.note { margin: 6px 0 12px; color: var(--o-dim); font-size: 13px; max-width: 80ch; }
.row { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
.grid2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 14px 22px; }
.field { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
.field label { color: var(--o-dim); font-size: 12.5px; }
.checks { display: flex; flex-direction: column; gap: 2px; }
.check { display: grid; grid-template-columns: 22px minmax(0, 1fr) auto; gap: 10px; align-items: center; padding: 9px 4px; border-bottom: 1px solid var(--o-line); }
.check .dot { width: 12px; height: 12px; border-radius: 50%; background: #4a4136; justify-self: center; }
.check.ok .dot { background: var(--o-ok); box-shadow: 0 0 10px rgba(127, 212, 154, .6); }
.check.warn .dot { background: var(--o-warn); }
.check.bad .dot { background: var(--o-bad); box-shadow: 0 0 10px rgba(255, 123, 110, .5); }
.check.run .dot { background: var(--o-acc); animation: pulse 1s infinite; }
.check .ct { min-width: 0; }
.check .ct b { font-weight: 500; }
.check .ct small { display: block; color: var(--o-dim); font-size: 12.5px; overflow-wrap: anywhere; }
.lab-box { position: relative; width: 480px; max-width: 100%; aspect-ratio: 16 / 9; background: #000; border-radius: 10px; overflow: hidden; border: 1px solid var(--o-line); }
.lab-box .vslot { opacity: 1 !important; }
.lab-box .vs-fb { gap: 10px; }
.lab-box .vs-fb .fb-t { font-size: 22px; } .lab-box .vs-fb .fb-k { font-size: 12px; } .lab-box .vs-fb .fb-play { width: 44px; height: 44px; }
.lab-box .vs-fb .fb-play::after { border-left-width: 14px; border-top-width: 9px; border-bottom-width: 9px; }
.lab-box .vs-fb a { font-size: 13px; }
.lab-box .empty { position: absolute; inset: 0; display: grid; place-items: center; color: var(--o-dim); font-size: 13px; text-align: center; padding: 20px; }
.tbl-wrap { overflow-x: auto; }
td.over { color: var(--o-bad); font-weight: 600; }
td.near { color: var(--o-warn); }
.json { width: 100%; min-height: 140px; font-family: var(--f-mono); font-size: 12px; }
</style>

<script>
/* ═══ SETTINGS + PRE-FLIGHT (S) ═══ */
const toastL = (html, ms) => toast(html, ms, { local: true });
const Panel = (() => {
  let root = null, tab = 'pre', lab = null, labKey = null, labTick = null;
  const TABS = [['pre', '课前预检'], ['media', '视频与音乐'], ['sound', '音量'], ['talk', '演讲'], ['runs', '排练记录'], ['keys', '键位']];
  function ensure() {
    if (root) return root;
    root = h('div.modal.op', { hidden: true, role: 'dialog', 'aria-modal': 'true', 'aria-label': '设置与课前预检' });
    root.addEventListener('click', (e) => { if (e.target === root) close(); });
    $('#ui').append(root);
    return root;
  }
  function open(which) { ensure(); if (which) tab = which; render(); root.hidden = false; }
  function close() { if (!root) return; root.hidden = true; stopLab(); }
  const isOpen = () => !!root && !root.hidden;

  function render() {
    root.innerHTML = '';
    const tabs = h('div.tabs', { role: 'tablist' }, ...TABS.map(([k, n]) => h('button', { type: 'button', role: 'tab', 'aria-selected': String(k === tab), text: n, on: { click: () => { tab = k; render(); } } })));
    const sheet = h('div.sheet', {},
      h('div.sheet-h', {}, h('h2', { text: '设置 · BEYOND THE SPOTLIGHT' }), tabs, h('button.btn.x', { type: 'button', text: '关闭 (Esc)', on: { click: close } })),
      h('div.sheet-b', {}, ({ pre: renderPre, media: renderMedia, sound: renderSound, talk: renderTalk, runs: renderRuns, keys: renderKeys })[tab]()));
    root.append(sheet);
  }

  /* ── pre-flight ── */
  const checks = {};
  function chk(id, name, run) { checks[id] = checks[id] || { id, name, st: 'idle', msg: '' }; checks[id].run = run; return checks[id]; }
  function defineChecks() {
    chk('proto', '页面打开方式', async () => /^https?:$/.test(location.protocol) ? ['ok', location.origin] : ['bad', '当前是 file:// 打开。YouTube 嵌入需要 http(s)：部署到 GitHub Pages，或在文件夹里运行 python3 -m http.server 后打开 http://localhost:8000']);
    chk('store', '本机存储（进度、设置、排练记录）', async () => store.ok() ? ['ok', '可用'] : ['bad', '浏览器禁止了本地存储：刷新后进度会丢失']);
    chk('yt', 'YouTube 播放接口', async () => (await YTAPI.ready()) ? ['ok', '已加载'] : ['bad', YTAPI.reason || '无法加载']);
    Object.keys(VIDEOS).forEach(k => chk('v-' + k, '视频 · ' + VIDEOS[k].name.zh, async () => {
      const so = Video.src(k);
      if (!so.set) return [k === 'motown' ? 'warn' : (k === 'trailer' ? 'bad' : 'warn'), k === 'motown' ? '可选：未设置时第三章 ⑤ 自动跳过' : '未设置链接（媒体页填写）'];
      if (so.file) return await new Promise(res => { const v = document.createElement('video'); v.preload = 'metadata'; v.onloadedmetadata = () => res(['ok', '本地文件 · ' + fmt(v.duration)]); v.onerror = () => res(['bad', '本地文件无法加载：' + so.file]); v.src = so.file; setTimeout(() => res(['bad', '超时']), 8000); });
      if (!so.id) return ['bad', '无法识别的链接'];
      const r = await Video.probe(so.id); return [r.ok ? 'ok' : 'bad', r.why + ' · ' + so.id];
    }));
    chk('cues', 'Smooth Criminal 提示点', async () => {
      const c = Settings.get().videos.sc.cues; const ok1 = c[0] && c[0].start != null && c[0].end != null, ok2 = c[1] && c[1].start != null && c[1].end != null;
      return ok1 && ok2 ? ['ok', `① ${fmt(c[0].start, true)}–${fmt(c[0].end, true)} · ② ${fmt(c[1].start, true)}–${fmt(c[1].end, true)}`] : ['warn', '提示点①②尚未全部设置：排练时播放视频并按 C 记录（起点、终点各按一次）'];
    });
    Object.keys(TRACKS).forEach(k => chk('m-' + k, '音乐 · ' + TRACKS[k].title, async () => { const r = await Music.probe(k); return [r.ok ? 'ok' : (r.why === '未设置' ? 'warn' : 'bad'), r.why]; }));
    chk('fonts', '字体', async () => {
      await document.fonts.ready;
      const fam = [['Bodoni Moda', 'A'], ['Barlow Condensed', '1'], ['Hahmlet', '빛'], ['IBM Plex Sans KR', '빛'], ['Noto Serif SC', '光'], ['Noto Sans SC', '光']];
      const miss = fam.filter(([f, s]) => !document.fonts.check(`20px "${f}"`, s)).map(f => f[0]);
      return miss.length ? ['warn', '尚未加载：' + miss.join('、') + '（联网后会自动加载）'] : ['ok', '全部到位'];
    });
    chk('pv', '演讲者视图', async () => (Date.now() - (window.__pvSeen || 0) < 3500) ? ['ok', '已连接'] : ['warn', '未连接：按 P 打开演讲者视图（拖到笔记本屏幕）']);
    chk('wake', '屏幕常亮', async () => Wake.active ? ['ok', '已开启'] : ['warn', '尚未开启（按任意键后自动申请；部分浏览器不支持）']);
    chk('fs', '全屏', async () => document.fullscreenElement ? ['ok', '已全屏'] : ['warn', '投影窗口里按 F 全屏']);
  }
  async function runCheck(c, rerender) {
    c.st = 'run'; c.msg = '检测中…'; rerender && rerender();
    try { const [st, msg] = await c.run(); c.st = st; c.msg = msg; } catch (e) { c.st = 'bad'; c.msg = String(e && e.message || e); }
    rerender && rerender();
  }
  function renderPre() {
    defineChecks();
    const list = h('div.checks');
    const paint = () => {
      list.innerHTML = '';
      Object.values(checks).forEach(c => list.append(h('div.check', { cls: c.st }, h('span.dot'), h('div.ct', {}, h('b', { text: c.name }), h('small', { text: c.msg || '未检测' })), h('button.btn.sm', { type: 'button', text: '检测', on: { click: () => runCheck(c, paint) } }))));
    };
    paint();
    const all = async () => { for (const c of Object.values(checks)) await runCheck(c, paint); const bad = Object.values(checks).filter(c => c.st === 'bad').length; toastL(bad ? `预检完成：${bad} 项需要处理` : '预检完成：可以开始'); };
    const warm = async () => {
      toastL('正在预热全部视频（静音）…');
      for (const k of Object.keys(VIDEOS)) { const so = Video.src(k); if (so.id) { const r = await Video.probe(so.id); checks['v-' + k] && (checks['v-' + k].st = r.ok ? 'ok' : 'bad', checks['v-' + k].msg = r.why + ' · ' + so.id); paint(); } }
      toastL('预热完成');
    };
    return h('div', {},
      h('div.sec', {}, h('h3', { text: '开讲前一屏全绿' }), h('p.note', { text: '在投影用的那台电脑、那个浏览器里检测。视频链接、提示点和音乐都在「视频与音乐」页设置；结果只反映当前这台电脑。' }),
        h('div.row', {}, h('button.btn.pri', { type: 'button', text: '全部检测', on: { click: all } }), h('button.btn', { type: 'button', text: '全部预热（静音加载视频）', on: { click: warm } }), h('button.btn', { type: 'button', text: '打开演讲者视图 (P)', on: { click: () => App.openPresenter() } }), h('button.btn', { type: 'button', text: '全屏 (F)', on: { click: () => App.fullscreen() } }))),
      list);
  }

  /* ── media ── */
  function startLab(key, from, lang) {
    const so = Video.src(key); const box = $('.lab-box', root); if (!box) return;
    if (lang === 'zh') { const z = (so.cfg.srcZh || '').trim(); if (!z) { toastL('还没有填中文字幕版链接'); return; } so.id = ytId(z); so.file = isFileSrc(z) ? z : null; }
    $('.empty', box) && $('.empty', box).remove();
    if (!lab) { lab = makeSlot('lab', box); }
    lab.place({ x: 0, y: 0, w: box.clientWidth, h: box.clientHeight }); lab.show(true); labKey = key;
    Video.registerLab && Video.registerLab(lab);
    lab.load({ key, id: so.id, file: so.file, start: from ?? (+so.cfg.start || 0), autoplay: true, muted: false });
    if (!labTick) labTick = setInterval(() => { const t = $('.lab-time', root); if (t && lab) t.textContent = `${fmt(lab.time(), true)} / ${fmt(lab.duration())}${lab.title ? ' ·「' + lab.title + '」' : ''}${lab.error ? ' · ' + lab.error : ''}`; }, 250);
  }
  function stopLab() { if (lab) { lab.stop(); lab.show(false); } clearInterval(labTick); labTick = null; }
  function renderMedia() {
    const s = Settings.get();
    const vidRow = (k) => {
      const cfg = s.videos[k];
      const inp = h('input', { type: 'text', value: cfg.src || '', placeholder: 'YouTube 链接 / 视频 ID / media/video/xxx.mp4', style: { width: '100%' } });
      inp.addEventListener('change', () => Settings.set(`videos.${k}.src`, inp.value.trim()));
      const extras = [];
      if ('start' in cfg) { const a = h('input', { type: 'number', step: '0.1', min: '0', value: cfg.start ?? 0 }); a.addEventListener('change', () => Settings.set(`videos.${k}.start`, +a.value || 0)); extras.push(h('label.muted', { text: k === 'bj' ? '从' : '入点' }), a); }
      if ('end' in cfg) { const b = h('input', { type: 'number', step: '0.1', min: '0', value: cfg.end ?? '' }); b.addEventListener('change', () => Settings.set(`videos.${k}.end`, b.value === '' ? null : +b.value)); extras.push(h('label.muted', { text: '出点' }), b); }
      if (k === 'trailer') {
        const zh = h('input', { type: 'text', value: cfg.srcZh || '', placeholder: '中文画面时用的版本（可空）', style: { width: '100%', marginTop: '6px' } });
        zh.addEventListener('change', () => Settings.set('videos.trailer.srcZh', zh.value.trim()));
        inp.placeholder = '韩文 / 双语画面时用的版本';
        return h('tr', {}, h('td', {}, h('b', { text: VIDEOS[k].name.zh }), h('div.muted', { text: '第 1 场 ② · 银幕 → 整屏 → 银幕' }), h('div.muted', { text: `时长 ${fmt(trailerSeconds(cfg))}${cfg.end != null ? '（按出点）' : cfg.dur ? '（实测）' : '（估计）'}` })),
          h('td', { style: { minWidth: '280px' } }, h('div.muted', { text: '韩文字幕版' }), inp, h('div.muted', { text: '中文字幕版', style: { marginTop: '6px' } }), zh),
          h('td', {}, h('div.row', {}, ...extras)),
          h('td', {}, h('div.row', {}, h('button.btn.sm', { type: 'button', text: '预览', on: { click: () => startLab(k) } }), h('button.btn.sm', { type: 'button', text: '预览中文版', on: { click: () => startLab(k, null, 'zh') } }))));
      }
      return h('tr', {}, h('td', {}, h('b', { text: VIDEOS[k].name.zh }), h('div.muted', { text: { trailer: '第 1 场 ② · 整屏播放', sc: '第 6 场 ④⑤ · 提示点', bj: '第 5 场 ③ · 显像管电视（静音）', motown: '第 5 场 ⑤ · 可选' }[k] })),
        h('td', { style: { minWidth: '280px' } }, inp), h('td', {}, h('div.row', {}, ...extras)), h('td', {}, h('button.btn.sm', { type: 'button', text: '预览', on: { click: () => startLab(k) } })));
    };
    const cues = clone(s.videos.sc.cues);
    const cueRows = cues.map((c, n) => {
      const st = h('input', { type: 'number', step: '0.1', min: '0', value: c.start ?? '' }), en = h('input', { type: 'number', step: '0.1', min: '0', value: c.end ?? '' });
      const lk = h('input', { type: 'text', value: c.label?.ko || '', placeholder: '字幕（韩）' }), lz = h('input', { type: 'text', value: c.label?.zh || '', placeholder: '字幕（中）' });
      const save = () => { const cc = clone(Settings.get().videos.sc.cues); cc[n] = { start: st.value === '' ? null : +st.value, end: en.value === '' ? null : +en.value, label: { ko: lk.value, zh: lz.value } }; Settings.set('videos.sc.cues', cc); };
      [st, en, lk, lz].forEach(x => x.addEventListener('change', save));
      const setNow = (which) => { if (!lab || labKey !== 'sc') { toastL('先在上方预览 Smooth Criminal'); return; } const t = Math.round(lab.time() * 10) / 10; (which === 's' ? st : en).value = t; save(); toastL(`提示点 ${n + 1} ${which === 's' ? '起点' : '终点'} = ${fmt(t, true)}`); };
      return h('tr', {}, h('td', { text: `提示点 ${n + 1}` + (n < 2 ? (n ? ' · 45° 倾斜' : ' · 俱乐部登场') : '') }),
        h('td', {}, h('div.row', {}, st, h('button.btn.sm', { type: 'button', text: '记当前', on: { click: () => setNow('s') } }))),
        h('td', {}, h('div.row', {}, en, h('button.btn.sm', { type: 'button', text: '记当前', on: { click: () => setNow('e') } }))),
        h('td', {}, h('div.row', {}, lk, lz)),
        h('td', {}, h('button.btn.sm', { type: 'button', text: '试播', on: { click: () => { if (c.start == null) return toastL('先设置起点'); startLab('sc', +st.value); } } })));
    });
    const labCtl = h('div.row', {},
      h('button.btn.sm', { type: 'button', text: '播放/暂停 (K)', on: { click: () => { if (!lab) return; lab.isPlaying() ? lab.pause() : lab.play(); } } }),
      h('button.btn.sm', { type: 'button', text: '−5 秒', on: { click: () => lab && lab.seek(lab.time() - 5) } }),
      h('button.btn.sm', { type: 'button', text: '+5 秒', on: { click: () => lab && lab.seek(lab.time() + 5) } }),
      h('button.btn.sm', { type: 'button', text: '−0.5', on: { click: () => lab && lab.seek(lab.time() - .5) } }),
      h('button.btn.sm', { type: 'button', text: '+0.5', on: { click: () => lab && lab.seek(lab.time() + .5) } }),
      h('span.mono.lab-time.muted', { text: '0:00.0' }),
      h('button.btn.sm', { type: 'button', text: '停止', on: { click: stopLab } }));
    const trackRows = Object.keys(TRACKS).map(k => {
      const t = TRACKS[k], cfg = s.tracks[k] || {};
      const src = h('input', { type: 'text', value: cfg.src || '', placeholder: 'media/music/xx.mp3 或 YouTube 链接', style: { width: '100%' } });
      const st = h('input', { type: 'number', step: '0.1', min: '0', value: cfg.start ?? 0 });
      src.addEventListener('change', () => Settings.set(`tracks.${k}.src`, src.value.trim()));
      st.addEventListener('change', () => Settings.set(`tracks.${k}.start`, +st.value || 0));
      const chipEl = h('span.chip', { text: '—' });
      return h('tr', {}, h('td', {}, h('b', { text: t.title }), h('div.muted', { text: `${t.year} · 从${t.cue}进` })), h('td', { style: { minWidth: '260px' } }, src), h('td', {}, st),
        h('td', {}, h('div.row', {}, h('button.btn.sm', { type: 'button', text: '试听 8 秒', on: { click: () => { SFX.ensure(); Music.preview(k, 8).then(ok => { chipEl.className = 'chip ' + (ok ? 'ok' : 'bad'); chipEl.textContent = ok ? '可播放' : (Music.status().error || '失败'); }); } } }),
          h('button.btn.sm', { type: 'button', text: '记当前为起点', on: { click: () => { const p = Music.position(k); if (p == null) return toastL('先点「试听」'); st.value = (Math.round(p * 10) / 10); Settings.set(`tracks.${k}.start`, +st.value); toastL(`${t.title} 起点 = ${fmt(+st.value, true)}`); } } }), chipEl)));
    });
    return h('div', {},
      h('div.sec', {}, h('h3', { text: '视频' }), h('p.note', { text: 'YouTube 链接或 11 位视频 ID 都可以；也可以填 media 文件夹里的本地视频文件（mp4/webm）。官方视频可能被所有者禁止嵌入，请在预检里确认。' }),
        h('div.tbl-wrap', {}, h('table', {}, h('tbody', {}, ...Object.keys(VIDEOS).map(vidRow))))),
      h('div.sec', {}, h('h3', { text: '预览与提示点' }), h('div.row', { style: { alignItems: 'flex-start', gap: '20px' } }, h('div.lab-box', {}, h('div.empty', { text: '点击上方「预览」在这里播放；播放 Smooth Criminal 时按 C 依次记录 ①起点 → ①终点 → ②起点 → ②终点' })), h('div', { style: { flex: '1', minWidth: '260px' } }, labCtl, h('p.note', { text: '提示点到点自动停；正式演讲时数字键 1–4 让视频跳到对应提示点。第四章 ⑥ 的画中画会循环播放提示点② 这一段（静音）。' }))),
        h('div.tbl-wrap', { style: { marginTop: '12px' } }, h('table', {}, h('thead', {}, h('tr', {}, ...['', '起点（秒）', '终点（秒）', '字幕', ''].map(t => h('th', { text: t })))), h('tbody', {}, ...cueRows)))),
      renderSubs(),
      h('div.sec', {}, h('h3', { text: '年代音乐' }), h('p.note', { text: '推荐本地音频（没有广告、不依赖网络）：把文件放进 media/music/ 并保持下列文件名，或改成你自己的路径。起点填「最有辨识度的那几秒」。注意：公开仓库的 GitHub Pages 会把音频公开，必要时只在本机放音频。' }),
        h('div.tbl-wrap', {}, h('table', {}, h('thead', {}, h('tr', {}, ...['曲目', '音源', '起点（秒）', ''].map(t => h('th', { text: t })))), h('tbody', {}, ...trackRows)))));
  }

  /* trailer subtitles: one line per subtitle — time | 韩文 | 中文 (time optional; 打点 fills it from the preview) */
  function renderSubs() {
    const cfg = Settings.get().videos.trailer;
    const toText = (list) => (list || []).map(c => [c.t != null ? fmt(c.t, true) : '', c.ko || '', c.zh || ''].join(' | ')).join('\n');
    const parseT = (x) => { x = String(x || '').trim(); if (!x) return null; const m = x.split(':').map(Number); if (m.some(isNaN)) return null; return m.length > 1 ? m[0] * 60 + m[1] : m[0]; };
    const fromText = (txt) => txt.split('\n').map(l => l.trim()).filter(Boolean).map(l => { const p = l.split('|').map(x => x.trim()); if (p.length === 1) return { t: null, ko: p[0], zh: '' }; if (p.length === 2) return { t: null, ko: p[0], zh: p[1] }; return { t: parseT(p[0]), ko: p[1], zh: p.slice(2).join(' | ') }; });
    const ta = h('textarea', { rows: '7', style: { width: '100%', font: '14px/1.5 var(--f-num), monospace' }, placeholder: '0:12.5 | 한국어 자막 | 中文字幕\n0:16.0 | … | …' });
    ta.value = toText(cfg.subs);
    const save = () => Settings.set('videos.trailer.subs', fromText(ta.value));
    ta.addEventListener('change', save);
    const pos = h('select', {}, h('option', { value: 'bottom', text: '画面底部', selected: cfg.subPos !== 'top' }), h('option', { value: 'top', text: '画面顶部（视频自带字幕时用）', selected: cfg.subPos === 'top' }));
    pos.addEventListener('change', () => Settings.set('videos.trailer.subPos', pos.value));
    const stamp = () => {
      if (!lab || labKey !== 'trailer') { toastL('先在上方预览预告片'); return; }
      const list = fromText(ta.value), i = list.findIndex(c => c.t == null);
      if (i < 0) { toastL('每一行都已经有时间了'); return; }
      list[i].t = Math.round(lab.time() * 10) / 10; ta.value = toText(list); save();
      toastL(`第 ${i + 1} 行 = ${fmt(list[i].t, true)}`);
    };
    return h('div.sec', {}, h('h3', { text: '预告片字幕（中韩对照，可选）' }),
      h('p.note', { text: '默认的两个官方版本已经各自带有字幕：韩文画面播韩文字幕版，中文画面播中文字幕版。想在「双语」画面里同时看到中韩两行时，在这里每行写一句：时间 | 韩文 | 中文。时间可以先空着，预览预告片时每句开口按一次「打点」。' }),
      ta, h('div.row', { style: { marginTop: '8px' } }, h('button.btn.sm', { type: 'button', text: '打点（下一句从现在开始）', on: { click: stamp } }), h('label.muted', { text: '位置' }), pos));
  }

  /* ── sound ── */
  function renderSound() {
    const v = Settings.get().vol;
    const slider = (k, name, hint) => {
      const out = h('span.mono', { text: v[k] + '%' });
      const r = h('input', { type: 'range', min: '0', max: '100', value: v[k], style: { width: '100%' } });
      r.addEventListener('input', () => { out.textContent = r.value + '%'; Settings.set(`vol.${k}`, +r.value, { silent: true }); Music.refreshVolumes(); });
      r.addEventListener('change', () => Settings.set(`vol.${k}`, +r.value));
      return h('div.field', {}, h('label', { text: `${name} · ${hint}` }), h('div.row', { style: { flexWrap: 'nowrap' } }, r, out));
    };
    const sfx = h('input', { type: 'checkbox', checked: Settings.get().sfx, id: 'opt-sfx' }); sfx.addEventListener('change', () => Settings.set('sfx', sfx.checked));
    return h('div', {},
      h('div.sec', {}, h('h3', { text: '三档音量' }), h('p.note', { text: '章节卡出现时用「章节卡」音量，2 秒后自动降到「讲话」；视频播放时让到「视频」档；视频结束 1.5 秒后回来。' }),
        h('div.grid2', {}, slider('master', '总音量', '全部声音'), slider('sfx', '效果音', '默认 70%'), slider('card', '章节卡', '默认 45%'), slider('speech', '讲话', '默认 18%'), slider('video', '视频播放时', '默认 0%'), slider('low', '第六章「阴影」', '几乎听不见'), slider('max', '终幕推到最高', 'Man in the Mirror'))),
      h('div.sec', {}, h('h3', { text: '效果音' }), h('div.row', {}, sfx, h('label', { for: 'opt-sfx', text: '年代溶解的气流声、幕间熄灯与追光点亮、场灯渐亮、章节卡低音、放映机与胶片走完、电视雪花声（全部是合成音，不需要文件；「减少动态」时自动关闭）' })), h('p.note', { text: '年代音乐：先找 media/music/ 里的本地文件，没有就用 YouTube 上的官方音源；下一年代的歌会提前载好，转场时旧歌一直响到新歌真正出声，再随画面溶解交叉过渡。' })));
  }

  /* ── talk ── */
  function renderTalk() {
    const s = Settings.get();
    const sel = (path, opts) => { const el = h('select', {}, ...opts.map(([v, n]) => h('option', { value: v, text: n, selected: String(path.split('.').reduce((o, k) => o[k], s)) === v }))); el.addEventListener('change', () => Settings.set(path, el.value)); return el; };
    const txt = (path) => { const el = h('input', { type: 'text', value: path.split('.').reduce((o, k) => o[k], s) }); el.addEventListener('change', () => Settings.set(path, el.value)); return el; };
    const rate = h('input', { type: 'number', min: '2', max: '7', step: '0.1', value: s.rate }); rate.addEventListener('change', () => Settings.set('rate', clamp(+rate.value || 3.5, 2, 7)));
    const measured = (() => { const r = Runs.list.slice().reverse().find(x => Runs.rate(x)); return r ? Runs.rate(r) : null; })();
    const trim = h('input', { type: 'checkbox', checked: s.trim, id: 'opt-trim' }); trim.addEventListener('change', () => Settings.set('trim', trim.checked));
    return h('div', {},
      h('div.sec', {}, h('h3', { text: '画面语言与节奏' }), h('div.grid2', {},
        h('div.field', {}, h('label', { text: '画面文字（L 键切换）' }), sel('lang', [['ko', '韩文（正式演讲）'], ['zh', '中文（排练 / 中文观众）'], ['bi', '双语字幕（韩文为主）']])),
        h('div.field', {}, h('label', { text: '语速假设（韩文音节/秒）· 用于时间预算和跟光节奏' }), h('div.row', {}, rate, measured ? h('button.btn.sm', { type: 'button', text: `用排练实测 ${measured.toFixed(2)}`, on: { click: () => { Settings.set('rate', Math.round(measured * 100) / 100); render(); } } }) : h('span.muted', { text: '排练后可一键换成实测语速' }))),
        h('div.field', {}, h('label', { text: '动态效果' }), sel('motion', [['auto', '跟随系统设置'], ['full', '完整动效'], ['reduce', '减少动态（0.2 秒淡入淡出，关闭闪光与粒子）']])),
        h('div.field', {}, h('label', { text: `画质 · 当前「${Q.name}」（${Q.why}）` }), sel('quality', [['auto', '自动（推荐：卡顿时自动降一级）'], ['high', '高 · 全部效果'], ['standard', '标准 · 胶片颗粒静止、粒子减半'], ['low', '省电 · 关闭滤镜与粒子（手机默认）']]),
          Perf.last ? h('p.note', { text: `最近一次翻页：中位帧间隔 ${Perf.last.med} ms（约 ${Perf.last.fps} fps），最慢一成 ${Perf.last.p90} ms` }) : null),
        h('div.field', {}, h('label', { text: '超时预案' }), h('div.row', {}, trim, h('label', { for: 'opt-trim', text: '跳过所有 ✂ 句子（翻页时直接越过）' }))))),
      h('div.sec', {}, h('h3', { text: '标题页署名' }), h('p.note', { text: '标题页底部的一行；中韩两份分别显示在对应语言模式下。' }), h('div.grid2', {},
        h('div.field', {}, h('label', { text: '姓名 · 한국어' }), txt('name.ko')), h('div.field', {}, h('label', { text: '姓名 · 中文' }), txt('name.zh')),
        h('div.field', {}, h('label', { text: '课程 · 한국어' }), txt('course.ko')), h('div.field', {}, h('label', { text: '课程 · 中文' }), txt('course.zh')),
        h('div.field', {}, h('label', { text: '所属 · 한국어' }), txt('org.ko')), h('div.field', {}, h('label', { text: '所属 · 中文' }), txt('org.zh')))),
      h('div.sec', {}, h('h3', { text: '进度与计时' }), h('div.row', {},
        h('button.btn', { type: 'button', text: '回到开场前（黑场待命）', on: { click: () => { App.cmd('reset'); close(); } } }),
        h('button.btn', { type: 'button', text: Session.running() ? '暂停计时' : '继续计时', on: { click: () => { App.cmd(Session.running() ? 'pause' : 'resume'); render(); } } }),
        h('button.btn', { type: 'button', text: '计时清零', on: { click: () => { App.cmd('clock-reset'); render(); } } }),
        h('button.btn', { type: 'button', text: '恢复默认设置', on: { click: () => { if (root.dataset.confirm === 'reset') { Settings.reset(); root.dataset.confirm = ''; toastL('已恢复默认设置'); render(); } else { root.dataset.confirm = 'reset'; toastL('再点一次确认恢复默认设置'); } } } }))));
  }

  /* ── rehearsal runs ── */
  function renderRuns() {
    const runs = Runs.list.slice(-3).reverse();
    const times = runs.map(r => Runs.sceneTimes(r));
    const head = h('tr', {}, h('th', { text: '场景' }), h('th', { text: '预算' }), ...runs.map(r => h('th', { text: new Date(r.started).toLocaleString('zh-CN', { month: 'numeric', day: 'numeric', hour: '2-digit', minute: '2-digit' }) + (r.done ? '' : ' · 进行中') })), h('th', { text: '提示' }));
    const rows = SCENES.map((sc, i) => {
      const cells = times.map(t => { const v = t[i]; const cls = v == null ? '' : v > sc.budget ? 'over' : v > sc.budget * .8 ? 'near' : ''; return h('td.mono', { cls, text: v == null ? '—' : fmt(v) }); });
      const overs = times.filter(t => t[i] != null && t[i] > sc.budget).length;
      return h('tr', {}, h('td', {}, T(sc.short)), h('td.mono', { text: fmt(sc.budget) }), ...cells, h('td', {}, overs >= 2 ? h('span.chip.bad', { text: '总是超时' }) : overs === 1 ? h('span.chip.warn', { text: '超时 1 次' }) : h('span.muted', { text: '' })));
    });
    const totals = h('tr', {}, h('td', {}, h('b', { text: '合计' })), h('td.mono', { text: fmt(TOTAL_PLAN) }), ...runs.map(r => h('td.mono', { cls: (r.total || 0) > HARD_LIMIT ? 'over' : '', text: r.total != null ? fmt(r.total) : '—' })), h('td'));
    const rates = runs.map(r => Runs.rate(r)).filter(Boolean);
    const ta = h('textarea.json', { placeholder: '导出的 JSON 会出现在这里；也可以把 JSON 粘贴进来再点「导入」' });
    const file = h('input', { type: 'file', accept: 'application/json,.json', style: { display: 'none' } });
    file.addEventListener('change', () => { const f = file.files[0]; if (!f) return; f.text().then(t => { ta.value = t; importJSON(t); }); });
    return h('div', {},
      h('div.sec', {}, h('h3', { text: '最近三次排练' }), h('p.note', { text: '从按下第一页开始自动记录每一拍的时间。红色 = 超出预算，黄色 = 用到预算的 80% 以上。' }),
        h('div.tbl-wrap', {}, h('table', {}, h('thead', {}, head), h('tbody', {}, ...rows, totals))),
        h('p.note', { text: rates.length ? `实测语速：${rates.map(r => r.toFixed(2)).join(' / ')} 音节/秒（当前假设 ${Settings.get().rate}）` : '还没有足够的排练数据来计算语速。' })),
      h('div.sec', {}, h('h3', { text: '导出 / 导入（换电脑时用）' }), h('div.row', {},
        h('button.btn', { type: 'button', text: '导出 JSON', on: { click: () => { const j = JSON.stringify({ app: 'beyond-the-spotlight', v: 1, settings: Settings.get(), runs: Runs.list }, null, 2); ta.value = j; try { const a = h('a', { href: URL.createObjectURL(new Blob([j], { type: 'application/json' })), download: 'beyond-the-spotlight-settings.json' }); document.body.append(a); a.click(); a.remove(); } catch (e) { /* sandboxed: copy from the box */ } } } }),
        h('button.btn', { type: 'button', text: '从文件导入', on: { click: () => file.click() } }),
        h('button.btn', { type: 'button', text: '导入下方 JSON', on: { click: () => importJSON(ta.value) } }),
        h('button.btn', { type: 'button', text: '清空排练记录', on: { click: () => { if (root.dataset.confirm === 'runs') { Runs.list = []; Runs.curId = null; Runs.save(); root.dataset.confirm = ''; render(); toastL('已清空'); } else { root.dataset.confirm = 'runs'; toastL('再点一次确认清空'); } } } }), file),
        h('div', { style: { marginTop: '12px' } }, ta)));
  }
  function importJSON(t) {
    try { const d = JSON.parse(t); if (d.settings) Settings.replace(d.settings); if (Array.isArray(d.runs)) { Runs.list = d.runs; Runs.save(); } toastL('已导入'); render(); }
    catch (e) { toastL('JSON 无法解析：' + e.message); }
  }

  /* ── keys ── */
  function renderKeys() {
    const K = [['A 或右上角 ∞', '自动演出开关（默认关闭）：关闭时全部手动，字幕每按一次 → 走一句；打开时字幕按排练语速走、页面自动翻'], ['V', '视频开关：随时播放 / 关闭这一页的视频（预告片、Smooth Criminal 等），没有就播放画面上第一个作品的 MV'], ['U', '中韩字幕开关（韩文在上、中文在下）'], ['Esc', '关闭正在播放的 MV'], ['→ ↓ PageDown 空格', '下一页（下一个节拍）'], ['← ↑ PageUp', '上一页（精确倒回）'], ['B 或 .', '黑场开关（翻页器的「黑屏」键）'], ['1 – 4', 'Smooth Criminal 跳到第 N 个提示点'], ['K', '视频播放 / 暂停（倒回到视频节拍时用它播放）'], ['Shift + ← / →', '视频后退 / 前进 5 秒'], ['C', '排练时记录提示点时间（起点、终点依次）'], ['↑ ↓（第四章 ⑥）', '现场调整倾斜角度（也可以用鼠标直接拖动人物）'], ['T', '鼠标手电筒 开 / 关'], ['G', '场景总览，问答时跳转'], ['M', '全部静音'], ['L', '切换 韩文 / 中文 / 双语'], ['F', '全屏'], ['P', '打开演讲者视图'], ['S', '设置与课前预检'], ['Esc', '关闭面板'], ['F5', '已屏蔽，防止翻页器误触刷新']];
    const I = [['移动鼠标', '手电筒：暗处的字和人会被照亮；画面随鼠标轻微视差'], ['冷开场 · 点人物', '重现摩城 25 的转身、踢腿、踮脚'], ['冷开场 ④ · 左右拖人物', '倒放 / 快进太空步'], ['卡片、唱片、票、胶片', '指针放上去会倾斜；唱片会滑出'], ['Thriller ③ · 电视旋钮', '在插画和真实 MV 之间换台'], ['Bad ⑥ · 拖人物', '改变倾斜角度，超过 30° 数字变色'], ['首尔 ② · 票根', '往右拖，把票根撕下来'], ['遗产 ① · 画框', '指针放上去，画里的人会动']];
    return h('div.sec', {}, h('h3', { text: '键位（兼容常见翻页器）' }), h('table', {}, h('tbody', {}, ...K.map(([k, d]) => h('tr', {}, h('td', { style: { width: '220px' } }, ...k.split(' ').map(x => /^(或|\+|–|（第四章|⑥）)$/.test(x) ? ' ' + x + ' ' : h('kbd', { text: x }))), h('td', { text: d }))))),
      h('h3', { text: '鼠标互动（全部可选，不影响翻页）', style: { marginTop: '26px' } }), h('table', {}, h('tbody', {}, ...I.map(([k, d]) => h('tr', {}, h('td', { style: { width: '220px' }, text: k }), h('td', { text: d }))))));
  }

  Settings.on(() => { if (isOpen() && tab !== 'media' && tab !== 'sound' && tab !== 'talk') render(); });
  return { open, close, get open_() { return isOpen(); }, isOpen, toggle(w) { isOpen() ? close() : open(w); }, lab: () => lab };
})();
</script>
